<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Accept Terms | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            body {
                margin: 0;
                background: #f5f5f5;
                font-family: "Fustat", sans-serif;
            }

            .page-shell {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #d9d9d9;
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand {
                color: #4E2A84;
                font-weight: bold;
                font-size: 1.25rem;
                text-decoration: none;
            }

            .auth-main {
                flex: 1;
                display: grid;
                place-items: center;
                padding: 48px 24px;
            }

            .auth-card {
                width: min(100%, 520px);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
                padding: 32px;
            }

            .auth-title {
                margin: 0 0 8px;
                font-family: "Rubik", sans-serif;
                font-size: 28px;
                font-weight: 700;
                line-height: 1.2;
            }

            .auth-copy {
                color: #454545;
                font-size: 16px;
                line-height: 1.5;
                margin: 0 0 24px;
            }

            .auth-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                min-height: 48px;
                border: 0;
                border-radius: 6px;
                background: #4E2A84;
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
            }

            .auth-button:hover,
            .auth-button:focus-visible {
                background: #3b1f66;
                color: #fff;
            }

            .auth-alert {
                margin: 0 0 16px;
                border-radius: 6px;
                padding: 10px 12px;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
            }

            .auth-alert.alert {
                background: #fff3f3;
                color: #9f1d1d;
            }

            .auth-alert.notice {
                background: #ecfdf3;
                color: #166534;
            }

            .terms-check-row {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                margin: 0 0 24px;
                font-size: 15px;
                line-height: 1.5;
                color: #222;
            }

            .terms-check-row input[type="checkbox"] {
                margin-top: 3px;
                flex-shrink: 0;
                width: 18px;
                height: 18px;
                accent-color: #4E2A84;
                cursor: pointer;
            }

            .terms-check-row a {
                color: #4E2A84;
                font-weight: 600;
            }
        </style>
        <%= render "pages/focus_styles" %>
        <%= render "shared/pwa_meta" %>
    </head>
    <body>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" aria-label="NU Sublets home">
                        <%= render "shared/brand_logo" %>
                    </a>
                </div>
            </header>

            <main class="auth-main">
                <section class="auth-card" aria-labelledby="terms-title">
                    <h1 class="auth-title" id="terms-title">Almost there!</h1>
                    <p class="auth-copy">Before you start using NU Sublets, please review and accept our Terms and Community Guidelines.</p>

                    <% flash.each do |type, message| %>
                        <p class="auth-alert <%= type %>" role="alert"><%= message %></p>
                    <% end %>

                    <%= form_with url: onboarding_accept_terms_path, method: :post, data: { turbo: false } do |f| %>
                        <div class="terms-check-row">
                            <%= f.check_box :terms_accepted %>
                            <label for="terms_accepted">
                                I agree to follow the NU Sublets Terms and Community Guidelines.
                                (<%= link_to "View Privacy Policy", privacy_policy_path %>)
                            </label>
                        </div>

                        <%= f.submit "Continue", class: "auth-button" %>
                    <% end %>
                </section>
            </main>

            <%= render "shared/footer" %>
        </div>
        <%= render "shared/service_worker_registration" %>
    </body>
</html>
