<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Sign Up | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            body {
                margin: 0;
                background: #f5f5f5;
                font-family: "Fustat", sans-serif;
            }

            .page-shell {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #d9d9d9;
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: #000;
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .auth-main {
                flex: 1;
                display: grid;
                place-items: center;
                padding: 48px 24px;
            }

            .auth-card {
                width: min(100%, 520px);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
                padding: 32px;
            }

            .auth-title {
                margin: 0 0 8px;
                font-family: "Rubik", sans-serif;
                font-size: 28px;
                font-weight: 700;
                line-height: 1.2;
            }

            .auth-copy,
            .auth-switch {
                color: #454545;
                font-size: 16px;
                line-height: 1.5;
            }

            .auth-copy {
                margin: 0 0 24px;
            }

            .auth-form,
            .auth-field {
                display: grid;
            }

            .auth-form {
                gap: 16px;
            }

            .auth-field {
                gap: 7px;
            }

            .auth-label {
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                font-weight: 600;
            }

            .auth-input {
                width: 100%;
                min-height: 46px;
                border: 1px solid #d9d9d9;
                border-radius: 6px;
                padding: 8px 12px;
                font: inherit;
            }

            .password-input-wrap {
                position: relative;
                width: 100%;
            }

            .password-input-wrap .auth-input {
                padding-right: 48px;
            }

            .password-visibility-toggle {
                position: absolute;
                top: 50%;
                right: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border: 0;
                border-radius: 4px;
                background: transparent;
                color: #5b5b5b;
                transform: translateY(-50%);
                cursor: pointer;
            }

            .password-visibility-toggle:hover,
            .password-visibility-toggle:focus-visible {
                color: #4E2A84;
                outline: 3px solid rgba(78, 42, 132, 0.26);
            }

            .password-visibility-toggle svg {
                width: 20px;
                height: 20px;
                display: block;
            }

            .password-visibility-toggle .eye-off-icon {
                display: none;
            }

            .password-visibility-toggle[aria-pressed="true"] .eye-icon {
                display: none;
            }

            .password-visibility-toggle[aria-pressed="true"] .eye-off-icon {
                display: block;
            }

            .auth-button {
                width: 100%;
                min-height: 48px;
                border: 0;
                border-radius: 6px;
                background: #4E2A84;
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 600;
            }

            .auth-alert {
                margin: 0 0 16px;
                border-radius: 6px;
                padding: 10px 12px;
                background: #fff3f3;
                color: #9f1d1d;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
            }

            .auth-switch {
                margin: 18px 0 0;
                text-align: center;
            }

            .auth-link {
                color: #4E2A84;
                font-weight: 600;
            }
        </style>
        <%= render "pages/focus_styles" %>
    <%= render "shared/pwa_meta" %>

    </head>
    <body>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <%= render "shared/brand_logo" %>
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: "recommendations") %>"><%= nav_item_label_with_icon(:browse, "Browse") %></a>
                        <a class="nav-link p-0" href="<%= search_results_path %>"><%= nav_item_label_with_icon(:search, "Search") %></a>
                        <a class="nav-link p-0" href="<%= saved_path %>"><%= nav_item_label_with_icon(:saved, "Saved") %></a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>"><%= nav_item_label_with_icon(:post_sublet, "Post Sublet") %></a>
                        <%= render "pages/auth_nav" %>
                    </nav>
                </div>
            </header>

            <main class="auth-main">
                <section class="auth-card" aria-labelledby="signup-title">
                    <h1 class="auth-title" id="signup-title">Create your account</h1>
                    <p class="auth-copy">Use your Northwestern email and a password of at least 8 characters.</p>

                    <% if flash[:alert].present? %>
                        <p class="auth-alert" role="alert"><%= flash[:alert] %></p>
                    <% end %>

                    <%= form_with model: @user, url: signup_path, method: :post, local: true, class: "auth-form" do |form| %>
                        <div class="auth-field">
                            <%= form.label :name, "Name", class: "auth-label" %>
                            <%= form.text_field :name, class: "auth-input", autocomplete: "name", required: true %>
                        </div>

                        <div class="auth-field">
                            <%= form.label :email, "Northwestern email", class: "auth-label" %>
                            <%= form.email_field :email, class: "auth-input", autocomplete: "email", required: true %>
                        </div>

                        <div class="auth-field">
                            <%= form.label :password, "Password", class: "auth-label" %>
                            <div class="password-input-wrap">
                                <%= form.password_field :password, class: "auth-input", autocomplete: "new-password", required: true, data: { password_toggle_input: true } %>
                                <%= render "shared/password_visibility_toggle" %>
                            </div>
                        </div>

                        <div class="auth-field">
                            <%= form.label :password_confirmation, "Password confirmation", class: "auth-label" %>
                            <div class="password-input-wrap">
                                <%= form.password_field :password_confirmation, class: "auth-input", autocomplete: "new-password", required: true, data: { password_toggle_input: true } %>
                                <%= render "shared/password_visibility_toggle" %>
                            </div>
                        </div>

                        <%= form.submit "Sign up", class: "auth-button" %>
                    <% end %>

                    <p class="auth-switch">
                        Already have an account?
                        <%= link_to "Log in", login_path, class: "auth-link" %>
                    </p>
                </section>
            </main>

            <%= render "shared/footer" %>
        </div>
        <script>
            (() => {
                document.querySelectorAll("[data-password-toggle]").forEach((toggle) => {
                    const input = toggle.closest(".password-input-wrap")?.querySelector("[data-password-toggle-input]");

                    toggle.addEventListener("click", () => {
                        if (!input) {
                            return;
                        }

                        const isPassword = input.type === "password";
                        input.type = isPassword ? "text" : "password";
                        toggle.setAttribute("aria-pressed", String(isPassword));
                        toggle.setAttribute("aria-label", isPassword ? "Hide password" : "Show password");
                    });
                });
            })();
        </script>
    <%= render "shared/service_worker_registration" %>

    </body>
</html>
