<!-- Simple Footer -->
<footer style="background: #f8f9fa; border-top: 1px solid #d9d9d9; margin-top: auto; padding: 2rem 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <div style="background: #4E2A84; width: 24px; height: 24px; border-radius: 4px; display: flex; align-items: center; justify-content: center; margin-right: 8px;">
                        <svg width="20" height="20" viewBox="0 0 32 24" fill="none">
                            <!-- House -->
                            <path d="M2 12L8 7L14 12V18C14 18.6 13.6 19 13 19H3C2.4 19 2 18.6 2 18V12Z" fill="white"/>
                            <path d="M6 15H10V19H6V15Z" fill="#4E2A84"/>
                            <!-- Wildcat head -->
                            <ellipse cx="24" cy="12" rx="6" ry="5" fill="white"/>
                            <!-- Cat ears -->
                            <path d="M20 8L21 6L22 8" fill="white" stroke="white" stroke-width="0.5"/>
                            <path d="M26 8L27 6L28 8" fill="white" stroke="white" stroke-width="0.5"/>
                            <!-- Cat eyes -->
                            <ellipse cx="21.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                            <ellipse cx="26.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                            <!-- Cat nose and mouth -->
                            <path d="M24 13.5L23.3 14.2L24.7 14.2Z" fill="#4E2A84"/>
                            <!-- Whiskers -->
                            <line x1="18" y1="11.5" x2="20" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                            <line x1="28" y1="11.5" x2="30" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                            <line x1="18.5" y1="13" x2="20" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                            <line x1="28" y1="13" x2="29.5" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                        </svg>
                    </div>
                    <h6 class="fw-bold mb-0">NU Sublets</h6>
                </div>
                <p class="text-muted mb-0">Find your perfect sublet near Northwestern University</p>
            </div>
            <div class="col-md-4 text-md-end">
                <p class="text-muted mb-1">&copy; 2026 NU Sublets</p>
                <%= link_to "Privacy Policy", privacy_policy_path, class: "text-muted" %>
            </div>
        </div>
    </div>
</footer>
