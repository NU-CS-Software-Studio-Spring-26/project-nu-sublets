<!-- Simple Footer -->
<footer style="background: #f8f9fa; border-top: 1px solid #d9d9d9; margin-top: auto; padding: 2rem 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <%= render 'shared/brand_logo', size: 24, text_class: 'fw-bold mb-0' %>
                </div>
                <p class="text-muted mb-0">
                    NU Sublets is a student-built platform for Northwestern-verified users.
                    Listings are user-generated and not verified by Northwestern University.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <p class="text-muted mb-1">&copy; 2026 NU Sublets</p>
                <nav aria-label="Footer links">
                    <%= link_to(nav_item_label_with_icon(:about_us, "About Us"), @footer_about_path || about_us_path, class: "text-muted nav-item-link") %>
                    <%= link_to(nav_item_label_with_icon(:privacy_policy, "Privacy Policy"), privacy_policy_path, class: "text-muted nav-item-link", style: "margin-left: 1.75rem;") %>
                    <%= link_to(nav_item_label_with_icon(:disclaimer, "Disclaimer"), disclaimer_path, class: "text-muted nav-item-link", style: "margin-left: 1.75rem;") %>
                    <%= link_to(nav_item_label_with_icon(:github, "GitHub Repository"), "https://github.com/NU-CS-Software-Studio-Spring-26/project-nu-sublets", class: "text-muted nav-item-link", style: "margin-left: 1.75rem;", target: "_blank", rel: "noopener") %>
                </nav>
            </div>
        </div>
    </div>
</footer>
