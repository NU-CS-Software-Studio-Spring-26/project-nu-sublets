<!-- Simple Footer -->
<footer style="background: #f8f9fa; border-top: 1px solid #d9d9d9; margin-top: auto; padding: 2rem 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <%= render 'shared/brand_logo', size: 24, text_class: 'fw-bold mb-0' %>
                </div>
                <p class="text-muted mb-0">Find your perfect sublet near Northwestern University</p>
            </div>
            <div class="col-md-4 text-md-end">
                <p class="text-muted mb-1">&copy; 2026 NU Sublets</p>
                <%= link_to "About Us", about_path, class: "text-muted" %>
                <span class="text-muted mx-2" aria-hidden="true">|</span>
                <%= link_to "Privacy Policy", privacy_policy_path, class: "text-muted" %>
            </div>
        </div>
    </div>
</footer>
