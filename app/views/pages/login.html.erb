<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Login | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            body {
                margin: 0;
                background: #f5f5f5;
                font-family: "Fustat", sans-serif;
            }

            .login-page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #d9d9d9;
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: #000;
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
                transition: color 0.2s ease;
            }

            .nav-link:hover,
            .nav-link:focus-visible {
                color: #4E2A84;
                outline: none;
            }

            .auth-main {
                min-height: calc(100vh - 60px);
                display: grid;
                place-items: center;
                padding: 48px 24px;
            }

            .auth-card {
                width: min(100%, 480px);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
                padding: 32px;
            }

            .auth-title {
                margin: 0 0 8px;
                font-family: "Rubik", sans-serif;
                font-size: 28px;
                font-weight: 700;
                line-height: 1.2;
            }

            .auth-copy,
            .auth-switch {
                color: #454545;
                font-size: 16px;
                line-height: 1.5;
            }

            .auth-copy {
                margin: 0 0 24px;
            }

            .auth-google {
                width: 100%;
                min-height: 48px;
                border-radius: 6px;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 600;
            }

            .auth-google {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #d9d9d9;
                background: #fff;
                color: #000;
            }

            .auth-alert {
                margin: 0 0 16px;
                border-radius: 6px;
                padding: 10px 12px;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
            }

            .auth-alert.alert {
                background: #fff3f3;
                color: #9f1d1d;
            }

            .auth-alert.notice {
                background: #ecfdf3;
                color: #166534;
            }

            .auth-switch {
                margin: 18px 0 0;
                text-align: center;
            }

            .auth-oauth-note {
                margin: 0;
                border-radius: 6px;
                background: #fff8e1;
                color: #5f4300;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                line-height: 1.45;
                padding: 10px 12px;
            }

            .auth-link {
                color: #4E2A84;
                font-weight: 600;
            }
        </style>
        <%= render "pages/focus_styles" %>
    <%= render "shared/pwa_meta" %>

    </head>
    <body>
        <div class="login-page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" aria-label="NU Sublets home" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <%= render 'shared/brand_logo' %>
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>"><%= nav_item_label_with_icon(:browse, "Browse") %></a>
                        <a class="nav-link p-0" href="<%= search_results_path %>"><%= nav_item_label_with_icon(:search, "Search") %></a>
                        <a class="nav-link p-0" href="<%= saved_path %>"><%= nav_item_label_with_icon(:saved, "Saved") %></a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>"><%= nav_item_label_with_icon(:post_sublet, "Post Sublet") %></a>
                        <%= render "pages/auth_nav" %>
                    </nav>
                </div>
            </header>

            <main class="auth-main">
                <section class="auth-card" aria-labelledby="login-title">
                    <h1 class="auth-title" id="login-title">Log in</h1>
                    <p class="auth-copy">Use your Northwestern account to browse, save, and post sublets.</p>

                    <% flash.each do |type, message| %>
                        <p class="auth-alert <%= type %>" role="alert"><%= message %></p>
                    <% end %>

                    <%= button_to "Sign in with Google",
                                  google_oauth_configured? ? "/auth/google_oauth2" : google_oauth_path,
                                  method: :post,
                                  class: "auth-google",
                                  data: { turbo: false } %>

                    <p class="auth-switch">
                        Need an account?
                        <%= link_to "Sign up", signup_path, class: "auth-link" %>
                    </p>
                </section>
            </main>

            <%= render "shared/footer" %>
        </div>
    <%= render "shared/service_worker_registration" %>

    </body>
</html>
