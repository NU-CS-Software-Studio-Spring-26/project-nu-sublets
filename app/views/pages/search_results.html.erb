<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Search Results | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-muted: #5b5b5b;
                --nu-accent: #4E2A84;
                --nu-card-shadow: 3.682px 3.682px 3.682px rgba(166, 166, 166, 0.25);
                --nu-toolbar-bg: #ffffff;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Fustat", sans-serif;
            }

            a {
                color: inherit;
            }

            img {
                display: block;
                max-width: 100%;
            }

            .page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid var(--nu-border);
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: var(--nu-text);
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .brand {
                font-weight: 400;
            }

            .results-toolbar {
                position: sticky;
                top: 60px;
                z-index: 20;
                border-bottom: 1px solid var(--nu-border);
                background: var(--nu-toolbar-bg);
            }

            .toolbar-inner,
            .results-shell {
                max-width: 1440px;
                margin: 0 auto;
                padding-inline: 32px;
            }

            .flash-error {
                background: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 8px;
                padding: 12px 16px;
                margin: 0 0 20px;
                color: #dc2626;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                font-weight: 500;
            }

            .toolbar-inner {
                min-height: 82px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .filter-form {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .date-range {
                display: inline-flex;
                align-items: stretch;
            }

            .date-filter {
                position: relative;
            }

            .date-chip,
            .date-filter-toggle {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                padding: 5px 14px;
                border: 1px solid var(--nu-border);
                background: #fff;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.15;
            }

            .date-filter + .date-filter .date-filter-toggle {
                border-left: 1px solid var(--nu-border);
            }

            .date-filter-toggle:hover,
            .date-filter-toggle:focus-visible {
                border-color: var(--nu-accent);
                outline: 0;
            }

            .date-filter-input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                pointer-events: none;
            }

            .filter-error {
                width: 100%;
                margin: 0;
                color: #b42318;
                font-family: "Rubik", sans-serif;
                font-size: 13px;
                line-height: 1.25;
            }

            .filter-error[hidden] {
                display: none;
            }

            .filter-menu {
                position: relative;
            }

            .filter-menu summary {
                list-style: none;
            }

            .filter-menu summary::-webkit-details-marker {
                display: none;
            }

            .filter-menu-toggle {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                min-height: 36px;
                padding: 5px 14px;
                border: 1px solid var(--nu-border);
                border-radius: 4px;
                background: #fff;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.15;
                cursor: pointer;
            }

            .filter-menu[open] .filter-menu-toggle,
            .filter-menu-toggle:hover,
            .filter-menu-toggle:focus-visible {
                border-color: var(--nu-accent);
                outline: 0;
            }

            .filter-menu-panel {
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                z-index: 1020;
                width: min(720px, calc(100vw - 64px));
                max-height: min(650px, calc(100vh - 170px));
                overflow: auto;
                padding: 18px;
                border: 1px solid rgba(0, 0, 0, 0.12);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);
            }

            .filter-panel-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .filter-group {
                min-width: 0;
            }

            .filter-group.is-wide {
                grid-column: 1 / -1;
            }

            .filter-group-title {
                margin: 0 0 9px;
                font-family: "Rubik", sans-serif;
                font-size: 13px;
                font-weight: 700;
                line-height: 1.2;
            }

            .filter-input-row {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }

            .filter-field,
            .filter-select {
                width: 100%;
                min-height: 38px;
                border: 1px solid var(--nu-border);
                border-radius: 4px;
                background: #fff;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                line-height: 1.2;
            }

            .filter-field {
                padding: 7px 10px;
            }

            .filter-select {
                padding: 7px 8px;
            }

            .filter-chip-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .filter-chip {
                display: inline-flex;
                align-items: center;
                min-height: 32px;
                padding: 6px 11px;
                border: 1px solid var(--nu-border);
                border-radius: 999px;
                background: #fff;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 13px;
                line-height: 1.1;
                cursor: pointer;
                user-select: none;
            }

            .filter-chip input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .filter-chip:has(input:checked) {
                border-color: var(--nu-accent);
                background: rgba(156, 81, 182, 0.1);
                color: #5c2c6d;
                font-weight: 600;
            }

            .filter-panel-actions {
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                margin-top: 16px;
                padding-top: 14px;
                border-top: 1px solid var(--nu-border);
            }

            .clear-filters-link {
                display: inline-flex;
                align-items: center;
                min-height: 36px;
                padding: 5px 10px;
                color: var(--nu-muted);
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                text-decoration: none;
            }

            .filter-button {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                min-height: 36px;
                padding: 5px 14px;
                border: 0;
                border-radius: 4px;
                background: var(--nu-accent);
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.15;
                transition: transform 0.2s ease, opacity 0.2s ease;
            }

            .filter-button:hover,
            .filter-button:focus-visible {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .filter-icon {
                width: 14px;
                height: 14px;
            }

            .date-picker-popover {
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                z-index: 1030;
                width: min(340px, calc(100vw - 48px));
                padding: 16px;
                border: 1px solid rgba(0, 0, 0, 0.12);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);
                font-family: "Rubik", sans-serif;
            }

            .date-picker-popover[hidden] {
                display: none;
            }

            .date-picker-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                margin-bottom: 14px;
            }

            .date-picker-title {
                flex: 1;
                text-align: center;
                font-size: 16px;
                font-weight: 600;
                line-height: 1.2;
            }

            .date-picker-nav {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                border: 1px solid rgba(0, 0, 0, 0.14);
                border-radius: 4px;
                background: #fff;
                color: var(--nu-text);
                font-size: 22px;
                line-height: 1;
            }

            .date-picker-nav:hover,
            .date-picker-nav:focus-visible,
            .date-picker-day:hover,
            .date-picker-day:focus-visible {
                border-color: var(--nu-accent);
                outline: 0;
            }

            .date-picker-weekdays,
            .date-picker-grid {
                display: grid;
                grid-template-columns: repeat(7, 1fr);
                gap: 6px;
            }

            .date-picker-weekdays {
                margin-bottom: 6px;
                color: rgba(0, 0, 0, 0.62);
                font-size: 12px;
                font-weight: 600;
                text-align: center;
            }

            .date-picker-day {
                width: 100%;
                aspect-ratio: 1;
                border: 1px solid transparent;
                border-radius: 4px;
                background: transparent;
                color: var(--nu-text);
                font-size: 15px;
                line-height: 1;
            }

            .date-picker-day.is-muted {
                color: rgba(0, 0, 0, 0.35);
            }

            .date-picker-day.is-today {
                border-color: rgba(156, 81, 182, 0.42);
            }

            .date-picker-day.is-selected {
                background: var(--nu-accent);
                color: #fff;
            }

            .results-page {
                padding: 24px 0 56px;
            }

            .results-title {
                margin: 0 0 16px;
                font-family: "Rubik", sans-serif;
                font-size: 18px;
                font-weight: 500;
                line-height: 1.15;
            }

            .results-grid {
                display: grid;
                grid-template-columns: minmax(0, 760px) minmax(300px, 1fr);
                gap: 34px;
                align-items: start;
            }

            .cards-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 24px 24px;
                max-width: 720px;
            }

            .listing-card {
                display: block;
                background: #fff;
                border-radius: 7px;
                overflow: hidden;
                box-shadow: var(--nu-card-shadow);
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .listing-card:hover,
            .listing-card:focus-visible {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .listing-card:focus-visible {
                outline: 3px solid rgba(156, 81, 182, 0.45);
                outline-offset: 4px;
            }

            .listing-media {
                position: relative;
                height: 190px;
                overflow: visible;
            }

            .listing-main-image {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

            .listing-avatar {
                position: absolute;
                left: 12px;
                bottom: -8px;
                width: 50px;
                height: 50px;
                border: 2px solid #fff;
                border-radius: 50%;
                object-fit: cover;
            }

            .listing-body {
                padding: 6px 8px 10px;
            }

            .listing-price {
                margin: 0 0 3px;
                font-family: "Rubik", sans-serif;
                font-size: 21px;
                font-weight: 800;
                line-height: 1.05;
            }

            .listing-card-title {
                margin: 0 0 3px;
                font-family: "Rubik", sans-serif;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.2;
            }

            .listing-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 3px;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                font-weight: 500;
                line-height: 1.2;
            }

            .listing-address {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                line-height: 1.2;
            }

            .empty-results {
                max-width: 720px;
                padding: 28px;
                border: 1px solid var(--nu-border);
                border-radius: 7px;
                background: #fff;
                font-family: "Rubik", sans-serif;
            }

            .empty-results-title {
                margin: 0 0 8px;
                font-size: 18px;
                font-weight: 600;
            }

            .empty-results-copy {
                margin: 0;
                color: var(--nu-muted);
                font-size: 14px;
                line-height: 1.45;
            }

            .map-card {
                position: sticky;
                top: 24px;
                background: #fff;
                max-width: 520px;
            }

            .map-stage {
                position: relative;
                width: 100%;
                min-height: 760px;
                border: 1px solid var(--nu-border);
                border-radius: 8px;
                overflow: hidden;
                background:
                    linear-gradient(90deg, rgba(255, 255, 255, 0.72) 49%, transparent 49% 51%, rgba(255, 255, 255, 0.72) 51%),
                    linear-gradient(0deg, rgba(255, 255, 255, 0.6) 49%, transparent 49% 51%, rgba(255, 255, 255, 0.6) 51%),
                    #dfe9dc;
                background-size: 110px 110px, 92px 92px, auto;
            }

            .map-canvas {
                position: absolute;
                inset: 0;
                transform-origin: center;
                transition: transform 0.2s ease;
            }

            .map-stage[data-zoom="2"] .map-canvas {
                transform: scale(1.08);
            }

            .map-stage[data-zoom="3"] .map-canvas {
                transform: scale(1.16);
            }

            .map-water {
                position: absolute;
                top: 0;
                right: 0;
                width: 23%;
                height: 100%;
                background: linear-gradient(180deg, #bed8ed, #9fc8e8);
                border-left: 2px solid rgba(45, 94, 126, 0.2);
            }

            .map-campus {
                position: absolute;
                top: 22%;
                right: 24%;
                width: 30%;
                height: 18%;
                border: 1px solid rgba(62, 27, 75, 0.16);
                border-radius: 14px;
                background: rgba(156, 81, 182, 0.12);
            }

            .map-road {
                position: absolute;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.9);
                box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
            }

            .map-road.horizontal {
                left: 4%;
                right: 22%;
                height: 9px;
            }

            .map-road.vertical {
                top: 3%;
                bottom: 3%;
                width: 9px;
            }

            .map-road.diagonal {
                left: 16%;
                top: 12%;
                width: 10px;
                height: 76%;
                transform: rotate(16deg);
                transform-origin: center;
            }

            .map-label {
                position: absolute;
                color: rgba(0, 0, 0, 0.48);
                font-family: "Rubik", sans-serif;
                font-size: 12px;
                font-weight: 600;
                line-height: 1;
                pointer-events: none;
            }

            .map-controls {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 4;
                display: grid;
                overflow: hidden;
                border: 1px solid rgba(0, 0, 0, 0.12);
                border-radius: 6px;
                background: #fff;
                box-shadow: 0 5px 14px rgba(0, 0, 0, 0.16);
            }

            .map-zoom-button {
                width: 36px;
                height: 36px;
                border: 0;
                background: #fff;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 22px;
                line-height: 1;
            }

            .map-zoom-button + .map-zoom-button {
                border-top: 1px solid var(--nu-border);
            }

            .map-zoom-button:hover,
            .map-zoom-button:focus-visible {
                background: #f5f1f7;
                outline: 0;
            }

            .map-pin {
                position: absolute;
                z-index: 3;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 54px;
                min-height: 32px;
                padding: 6px 10px;
                border: 2px solid #fff;
                border-radius: 999px;
                background: #d93025;
                color: #fff;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                font-weight: 800;
                line-height: 1;
                transform: translate(-50%, -100%);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .map-pin::after {
                content: "";
                position: absolute;
                left: 50%;
                bottom: -8px;
                width: 13px;
                height: 13px;
                background: #d93025;
                border-right: 2px solid #fff;
                border-bottom: 2px solid #fff;
                transform: translateX(-50%) rotate(45deg);
            }

            .map-pin.count-pin {
                background: var(--nu-accent);
            }

            .map-pin.count-pin::after {
                background: var(--nu-accent);
            }

            .map-pin:hover,
            .map-pin:focus-visible,
            .map-pin[aria-expanded="true"] {
                z-index: 5;
                outline: 0;
                transform: translate(-50%, -100%) scale(1.08);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.28);
            }

            .map-stage[data-zoom="2"] .map-pin {
                min-width: 62px;
                min-height: 36px;
                font-size: 16px;
            }

            .map-stage[data-zoom="3"] .map-pin {
                min-width: 72px;
                min-height: 42px;
                font-size: 18px;
            }

            .map-popup {
                position: absolute;
                z-index: 6;
                width: min(320px, calc(100% - 24px));
                max-height: 360px;
                overflow: auto;
                padding: 12px;
                border: 1px solid rgba(0, 0, 0, 0.12);
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 18px 38px rgba(0, 0, 0, 0.22);
                transform: translate(-50%, 14px);
            }

            .map-popup[hidden] {
                display: none;
            }

            .map-popup-title {
                margin: 0 24px 8px 0;
                font-family: "Rubik", sans-serif;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.25;
            }

            .map-popup-close {
                position: absolute;
                top: 8px;
                right: 8px;
                width: 24px;
                height: 24px;
                border: 0;
                border-radius: 4px;
                background: transparent;
                color: var(--nu-text);
                font-size: 20px;
                line-height: 1;
            }

            .map-popup-close:hover,
            .map-popup-close:focus-visible {
                background: #f5f1f7;
                outline: 0;
            }

            .map-popup-listing {
                display: block;
                padding: 10px 0;
                color: inherit;
                text-decoration: none;
            }

            .map-popup-listing + .map-popup-listing {
                border-top: 1px solid var(--nu-border);
            }

            .map-popup-price {
                margin: 0 0 4px;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 800;
                line-height: 1.1;
            }

            .map-popup-name,
            .map-popup-meta,
            .map-popup-address {
                margin: 0;
                font-size: 12px;
                line-height: 1.35;
            }

            .map-popup-name {
                font-family: "Rubik", sans-serif;
                font-weight: 600;
            }

            .map-popup-meta,
            .map-popup-address {
                color: var(--nu-muted);
            }

            .map-empty {
                position: absolute;
                inset: 0;
                display: grid;
                place-items: center;
                padding: 24px;
                color: var(--nu-muted);
                font-family: "Rubik", sans-serif;
                text-align: center;
            }

            @media (max-width: 1199.98px) {
                .results-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 24px;
                }

                .map-card {
                    position: static;
                }

                .map-card {
                    max-width: none;
                }

                .map-stage {
                    height: 420px;
                    min-height: 420px;
                }
            }

            @media (max-width: 991.98px) {
                .date-chip,
                .filter-button {
                    font-size: 14px;
                }

                .filter-icon {
                    width: 13px;
                    height: 13px;
                }

                .cards-grid {
                    gap: 24px;
                }

            }

            @media (max-width: 767.98px) {
                .topbar {
                    padding-inline: 16px;
                }

                .topbar-nav {
                    gap: 20px;
                }

                .brand,
                .nav-link {
                    font-size: 14px;
                }

                .toolbar-inner,
                .results-shell {
                    padding-inline: 16px;
                }

                .results-toolbar {
                    top: 60px;
                }

                .toolbar-inner {
                    min-height: 72px;
                    flex-wrap: wrap;
                    align-items: center;
                    padding-block: 8px;
                }

                .filter-form {
                    width: 100%;
                }

                .filter-menu {
                    position: static;
                }

                .filter-menu-panel {
                    left: 16px;
                    right: 16px;
                    width: auto;
                    max-height: calc(100vh - 160px);
                }

                .filter-panel-grid {
                    grid-template-columns: 1fr;
                }

                .date-range {
                    width: 100%;
                }

                .date-filter {
                    flex: 1 1 0;
                }

                .date-filter-toggle {
                    width: 100%;
                    min-width: 0;
                    font-size: 13px;
                }

                .filter-button {
                    font-size: 13px;
                }

                .results-page {
                    padding-top: 16px;
                }

                .results-title {
                    font-size: 16px;
                }

                .cards-grid {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }

                .listing-media {
                    height: 216px;
                }

                .listing-main-image {
                    height: 204px;
                }
            }
        </style>
    </head>
    <body>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <div style="background: #4E2A84; width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-right: 8px;">
                            <svg width="24" height="24" viewBox="0 0 32 24" fill="none">
                                <!-- House -->
                                <path d="M2 12L8 7L14 12V18C14 18.6 13.6 19 13 19H3C2.4 19 2 18.6 2 18V12Z" fill="white"/>
                                <path d="M6 15H10V19H6V15Z" fill="#4E2A84"/>
                                <!-- Wildcat head -->
                                <ellipse cx="24" cy="12" rx="6" ry="5" fill="white"/>
                                <!-- Cat ears -->
                                <path d="M20 8L21 6L22 8" fill="white" stroke="white" stroke-width="0.5"/>
                                <path d="M26 8L27 6L28 8" fill="white" stroke="white" stroke-width="0.5"/>
                                <!-- Cat eyes -->
                                <ellipse cx="21.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                                <ellipse cx="26.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                                <!-- Cat nose and mouth -->
                                <path d="M24 13.5L23.3 14.2L24.7 14.2Z" fill="#4E2A84"/>
                                <!-- Whiskers -->
                                <line x1="18" y1="11.5" x2="20" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="28" y1="11.5" x2="30" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="18.5" y1="13" x2="20" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="28" y1="13" x2="29.5" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                            </svg>
                        </div>
                        NU Sublets
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>">Browse</a>
                        <a class="nav-link p-0" href="<%= saved_path %>">Saved</a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>">Post Sublet</a>
                        <a class="nav-link p-0" href="<%= listing_path %>">Featured Listing</a>
                        <%= render "auth_nav" %>
                    </nav>
                </div>
            </header>

            <section class="results-toolbar" aria-label="Search filters">
                <div class="toolbar-inner">
                    <form class="filter-form" action="<%= search_results_path %>" method="get" data-search-filter-form novalidate>
                        <div class="date-range" role="group" aria-label="Selected dates">
                            <div class="date-filter" data-date-picker>
                                <input class="date-filter-input" type="text" name="move-in" value="<%= @move_in&.strftime("%m/%d/%Y") %>" data-date-input />
                                <button class="date-filter-toggle" type="button" aria-label="Open move in date picker" aria-expanded="false" aria-controls="search-move-in-picker" data-date-toggle>
                                    <span data-date-label><%= @move_in&.strftime("%b %-d %Y") || "Move in" %></span>
                                </button>
                                <div class="date-picker-popover" id="search-move-in-picker" role="dialog" aria-label="Move in calendar" hidden data-date-popover></div>
                            </div>

                            <div class="date-filter" data-date-picker>
                                <input class="date-filter-input" type="text" name="move-out" value="<%= @move_out&.strftime("%m/%d/%Y") %>" data-date-input />
                                <button class="date-filter-toggle" type="button" aria-label="Open move out date picker" aria-expanded="false" aria-controls="search-move-out-picker" data-date-toggle>
                                    <span data-date-label><%= @move_out&.strftime("%b %-d %Y") || "Move out" %></span>
                                </button>
                                <div class="date-picker-popover" id="search-move-out-picker" role="dialog" aria-label="Move out calendar" hidden data-date-popover></div>
                            </div>
                        </div>

                        <details class="filter-menu" data-filter-menu>
                            <summary class="filter-menu-toggle">
                                <svg class="filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                </svg>
                                <span>More filters</span>
                            </summary>

                            <div class="filter-menu-panel">
                                <div class="filter-panel-grid">
                                    <div class="filter-group">
                                        <p class="filter-group-title">Monthly rent</p>
                                        <div class="filter-input-row">
                                            <input class="filter-field" type="number" name="min_price" min="0" step="50" value="<%= @min_price %>" placeholder="Min $" aria-label="Minimum monthly rent" data-filter-control />
                                            <input class="filter-field" type="number" name="max_price" min="0" step="50" value="<%= @max_price %>" placeholder="Max $" aria-label="Maximum monthly rent" data-filter-control />
                                        </div>
                                    </div>

                                    <div class="filter-group">
                                        <p class="filter-group-title">Space</p>
                                        <div class="filter-input-row">
                                            <select class="filter-select" name="bedrooms" aria-label="Bedrooms" data-filter-control>
                                                <option value="">Any bedrooms</option>
                                                <% (0..4).each do |count| %>
                                                    <option value="<%= count %>" <%= "selected" if @bedrooms == count.to_s %>><%= count.zero? ? "Studio" : pluralize(count, "bedroom") %></option>
                                                <% end %>
                                            </select>

                                            <select class="filter-select" name="bathrooms" aria-label="Bathrooms" data-filter-control>
                                                <option value="">Any bathrooms</option>
                                                <% (1..4).each do |count| %>
                                                    <option value="<%= count %>" <%= "selected" if @bathrooms == count.to_s %>><%= pluralize(count, "bathroom") %></option>
                                                <% end %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="filter-group is-wide">
                                        <p class="filter-group-title">Amenities</p>
                                        <div class="filter-chip-grid">
                                            <% SubletListing::AMENITY_OPTIONS.each do |amenity| %>
                                                <label class="filter-chip">
                                                    <input type="checkbox" name="amenities[]" value="<%= amenity %>" <%= "checked" if @selected_amenities.include?(amenity) %> data-filter-control />
                                                    <span><%= amenity %></span>
                                                </label>
                                            <% end %>
                                        </div>
                                    </div>

                                    <div class="filter-group is-wide">
                                        <p class="filter-group-title">Preferences</p>
                                        <div class="filter-chip-grid">
                                            <% SubletListing::PREFERENCE_OPTIONS.each do |preference| %>
                                                <label class="filter-chip">
                                                    <input type="checkbox" name="preferences[]" value="<%= preference %>" <%= "checked" if @selected_preferences.include?(preference) %> data-filter-control />
                                                    <span><%= preference %></span>
                                                </label>
                                            <% end %>
                                        </div>
                                    </div>
                                </div>

                                <div class="filter-panel-actions">
                                    <a class="clear-filters-link" href="<%= search_results_path %>">Clear all</a>
                                </div>
                            </div>
                        </details>

                        <button class="filter-button" type="submit">
                            <svg class="filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                            <span>Filter</span>
                        </button>

                        <p class="filter-error" role="alert" hidden data-filter-error></p>
                    </form>
                </div>
            </section>

            <main class="results-page">
                <div class="results-shell">
                    <% if flash[:error] %>
                        <div class="flash-error">
                            <%= flash[:error] %>
                        </div>
                    <% end %>
                    <h1 class="results-title"><%= pluralize(@listings.count, "Sublet") %> Available</h1>

                    <div class="results-grid">
                        <section class="cards-grid" aria-label="Search result listings">
                            <% if @listings.any? %>
                                <% avatar_images = [
                                    "https://randomuser.me/api/portraits/women/65.jpg",
                                    "https://randomuser.me/api/portraits/men/73.jpg",
                                    "https://randomuser.me/api/portraits/women/27.jpg",
                                    "https://randomuser.me/api/portraits/men/15.jpg",
                                    "https://randomuser.me/api/portraits/women/32.jpg",
                                    "https://randomuser.me/api/portraits/men/12.jpg",
                                    "https://randomuser.me/api/portraits/women/18.jpg",
                                    "https://randomuser.me/api/portraits/men/8.jpg",
                                    "https://randomuser.me/api/portraits/women/12.jpg",
                                    "https://randomuser.me/api/portraits/women/28.jpg",
                                    "https://randomuser.me/api/portraits/men/18.jpg",
                                    "https://randomuser.me/api/portraits/women/24.jpg"
                                ] %>
                                <% @listings.each_with_index do |listing, index| %>
                                    <a class="listing-card" href="<%= sublet_listing_path(listing) %>">
                                        <div class="listing-media">
                                            <img class="listing-main-image" src="<%= apartment_listing_image_path(listing) %>" alt="<%= listing.title %>" />
                                            <img class="listing-avatar" src="<%= avatar_images[index % avatar_images.length] %>" alt="Listing host" />
                                        </div>
                                        <div class="listing-body">
                                            <p class="listing-price"><%= number_to_currency(listing.price, precision: 0) %>/month</p>
                                            <p class="listing-card-title"><%= listing.title %></p>
                                            <div class="listing-meta">
                                                <span><%= pluralize(listing.bedrooms, "bedroom") %></span>
                                                <span><%= pluralize(listing.bathrooms, "bathroom") %></span>
                                                <span><%= listing.available_from.strftime("%b %-d") %> - <%= listing.available_until.strftime("%b %-d") %></span>
                                            </div>
                                            <p class="listing-address"><%= listing.address %></p>
                                        </div>
                                    </a>
                                <% end %>
                            <% else %>
                                <div class="empty-results">
                                    <p class="empty-results-title">No sublets cover those dates yet.</p>
                                    <p class="empty-results-copy">Try widening your move-in or move-out dates to see more available listings.</p>
                                </div>
                            <% end %>
                        </section>

                        <aside class="map-card" aria-label="Map of listings">
                            <% map_groups = listing_map_groups(@listings) %>
                            <div class="map-stage" data-map-stage data-zoom="1" aria-label="Sublet map">
                                <div class="map-canvas" data-map-canvas>
                                    <div class="map-water" aria-hidden="true"></div>
                                    <div class="map-campus" aria-hidden="true"></div>
                                    <div class="map-road horizontal" style="top: 18%" aria-hidden="true"></div>
                                    <div class="map-road horizontal" style="top: 36%" aria-hidden="true"></div>
                                    <div class="map-road horizontal" style="top: 54%" aria-hidden="true"></div>
                                    <div class="map-road horizontal" style="top: 72%" aria-hidden="true"></div>
                                    <div class="map-road vertical" style="left: 18%" aria-hidden="true"></div>
                                    <div class="map-road vertical" style="left: 36%" aria-hidden="true"></div>
                                    <div class="map-road vertical" style="left: 54%" aria-hidden="true"></div>
                                    <div class="map-road diagonal" aria-hidden="true"></div>
                                    <span class="map-label" style="top: 24%; right: 31%">Northwestern</span>
                                    <span class="map-label" style="top: 48%; right: 5%">Lake Michigan</span>
                                    <span class="map-label" style="bottom: 18%; left: 10%">Evanston</span>

                                    <% map_groups.each_with_index do |group, index| %>
                                        <% listings = group[:listings] %>
                                        <% single_listing = listings.one? %>
                                        <% pin_label = single_listing ? number_to_currency(listings.first.price, precision: 0) : listings.count.to_s %>
                                        <% pin_aria_label = single_listing ? "#{pin_label} sublet at #{group[:address]}" : "#{pluralize(listings.count, 'listing')} at #{group[:address]}" %>
                                        <% popup_id = "map-popup-#{index}" %>
                                        <button
                                            class="map-pin <%= "count-pin" unless single_listing %>"
                                            type="button"
                                            style="left: <%= group[:x] %>%; top: <%= group[:y] %>%"
                                            aria-label="<%= pin_aria_label %>"
                                            aria-expanded="false"
                                            aria-controls="<%= popup_id %>"
                                            data-map-pin
                                            data-popup-id="<%= popup_id %>"
                                        >
                                            <%= single_listing ? pin_label : listings.count %>
                                        </button>

                                        <div
                                            class="map-popup"
                                            id="<%= popup_id %>"
                                            style="left: <%= group[:x] %>%; top: <%= group[:y] %>%"
                                            hidden
                                            data-map-popup
                                        >
                                            <button class="map-popup-close" type="button" aria-label="Close listing popup" data-map-popup-close>&times;</button>
                                            <p class="map-popup-title"><%= group[:address] %></p>
                                            <% listings.each do |listing| %>
                                                <a class="map-popup-listing" href="<%= sublet_listing_path(listing) %>">
                                                    <p class="map-popup-price"><%= number_to_currency(listing.price, precision: 0) %>/month</p>
                                                    <p class="map-popup-name"><%= listing.title %></p>
                                                    <p class="map-popup-meta"><%= pluralize(listing.bedrooms, "bedroom") %> · <%= pluralize(listing.bathrooms, "bathroom") %> · <%= listing.available_from.strftime("%b %-d") %> - <%= listing.available_until.strftime("%b %-d") %></p>
                                                    <p class="map-popup-address"><%= listing.address %></p>
                                                </a>
                                            <% end %>
                                        </div>
                                    <% end %>

                                    <% if map_groups.empty? %>
                                        <div class="map-empty">Search results with addresses will appear on the map.</div>
                                    <% end %>
                                </div>

                                <div class="map-controls" aria-label="Map zoom controls">
                                    <button class="map-zoom-button" type="button" aria-label="Zoom in" data-map-zoom-in>+</button>
                                    <button class="map-zoom-button" type="button" aria-label="Zoom out" data-map-zoom-out>&minus;</button>
                                </div>
                            </div>
                        </aside>
