<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Search Results | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-muted: #5b5b5b;
                --nu-accent: #9c51b6;
                --nu-card-shadow: 3.682px 3.682px 3.682px rgba(166, 166, 166, 0.25);
                --nu-toolbar-bg: #ffffff;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Fustat", sans-serif;
            }

            a {
                color: inherit;
            }

            img {
                display: block;
                max-width: 100%;
            }

            .page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid var(--nu-border);
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: var(--nu-text);
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .brand {
                font-weight: 400;
            }

            .results-toolbar {
                position: sticky;
                top: 60px;
                z-index: 20;
                border-bottom: 1px solid var(--nu-border);
                background: var(--nu-toolbar-bg);
            }

            .toolbar-inner,
            .results-shell {
                max-width: 1440px;
                margin: 0 auto;
                padding-inline: 32px;
            }

            .toolbar-inner {
                min-height: 82px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .date-range {
                display: inline-flex;
                align-items: stretch;
                border: 1px solid var(--nu-border);
                background: #fff;
            }

            .date-chip {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                padding: 5px 14px;
                border: 0;
                background: transparent;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.15;
            }

            .date-chip + .date-chip {
                border-left: 1px solid var(--nu-border);
            }

            .filter-button {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                min-height: 36px;
                padding: 5px 14px;
                border: 0;
                border-radius: 4px;
                background: var(--nu-accent);
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.15;
                transition: transform 0.2s ease, opacity 0.2s ease;
            }

            .filter-button:hover,
            .filter-button:focus-visible {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .filter-icon {
                width: 14px;
                height: 14px;
            }

            .results-page {
                padding: 24px 0 56px;
            }

            .results-title {
                margin: 0 0 16px;
                font-family: "Rubik", sans-serif;
                font-size: 18px;
                font-weight: 500;
                line-height: 1.15;
            }

            .results-grid {
                display: grid;
                grid-template-columns: minmax(0, 760px) minmax(300px, 1fr);
                gap: 34px;
                align-items: start;
            }

            .cards-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 24px 24px;
                max-width: 720px;
            }

            .listing-card {
                display: block;
                background: #fff;
                border-radius: 7px;
                overflow: hidden;
                box-shadow: var(--nu-card-shadow);
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .listing-card:hover,
            .listing-card:focus-visible {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .listing-card:focus-visible {
                outline: 3px solid rgba(156, 81, 182, 0.45);
                outline-offset: 4px;
            }

            .listing-media {
                position: relative;
                height: 190px;
                overflow: visible;
            }

            .listing-main-image {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

            .listing-avatar {
                position: absolute;
                left: 12px;
                bottom: -8px;
                width: 50px;
                height: 50px;
                border: 2px solid #fff;
                border-radius: 50%;
                object-fit: cover;
            }

            .listing-body {
                padding: 6px 8px 10px;
            }

            .listing-price {
                margin: 0 0 3px;
                font-family: "Rubik", sans-serif;
                font-size: 21px;
                font-weight: 800;
                line-height: 1.05;
            }

            .listing-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 3px;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                font-weight: 500;
                line-height: 1.2;
            }

            .listing-address {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                line-height: 1.2;
            }

            .map-card {
                position: sticky;
                top: 24px;
                background: #fff;
            }

            .map-embed {
                width: 100%;
                max-width: 447px;
                height: 950px;
                border: 0;
                display: block;
            }

            @media (max-width: 1199.98px) {
                .results-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 24px;
                }

                .map-card {
                    position: static;
                }

                .map-embed {
                    max-width: 100%;
                    height: 420px;
                }
            }

            @media (max-width: 991.98px) {
                .date-chip,
                .filter-button {
                    font-size: 14px;
                }

                .filter-icon {
                    width: 13px;
                    height: 13px;
                }

                .cards-grid {
                    gap: 24px;
                }

            }

            @media (max-width: 767.98px) {
                .topbar {
                    padding-inline: 16px;
                }

                .topbar-nav {
                    gap: 20px;
                }

                .brand,
                .nav-link {
                    font-size: 14px;
                }

                .toolbar-inner,
                .results-shell {
                    padding-inline: 16px;
                }

                .results-toolbar {
                    top: 60px;
                }

                .toolbar-inner {
                    min-height: 72px;
                    flex-wrap: wrap;
                    align-items: center;
                    padding-block: 8px;
                }

                .date-range {
                    width: 100%;
                }

                .date-chip {
                    flex: 1 1 0;
                    min-width: 0;
                    font-size: 13px;
                }

                .filter-button {
                    font-size: 13px;
                }

                .results-page {
                    padding-top: 16px;
                }

                .results-title {
                    font-size: 16px;
                }

                .cards-grid {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }

                .listing-media {
                    height: 216px;
                }

                .listing-main-image {
                    height: 204px;
                }
            }
        </style>
    </head>
