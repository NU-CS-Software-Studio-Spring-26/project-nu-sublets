<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>About Us | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            body {
                margin: 0;
                background: #fff;
                color: #000;
                font-family: "Fustat", sans-serif;
            }

            .page-shell {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #d9d9d9;
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: #000;
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .about-main {
                flex: 1;
                padding: 48px 24px;
            }

            .about-content {
                max-width: 820px;
                margin: 0 auto;
            }

            .about-content h1,
            .about-content h2 {
                font-family: "Rubik", sans-serif;
            }

            .about-content h1 {
                margin-bottom: 12px;
                font-size: 40px;
                font-weight: 800;
            }

            .about-content h2 {
                margin-top: 32px;
                font-size: 22px;
                font-weight: 700;
            }

            .about-content p {
                color: #454545;
                font-size: 17px;
                line-height: 1.65;
            }
        </style>
        <%= render "focus_styles" %>
    <%= render "shared/pwa_meta" %>

    </head>
    <body>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <%= render 'shared/brand_logo' %>
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>"><%= nav_item_label_with_icon(:browse, "Browse") %></a>
                        <a class="nav-link p-0" href="<%= search_results_path %>"><%= nav_item_label_with_icon(:search, "Search") %></a>
                        <a class="nav-link p-0" href="<%= saved_path %>"><%= nav_item_label_with_icon(:saved, "Saved") %></a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>"><%= nav_item_label_with_icon(:post_sublet, "Post Sublet") %></a>
                        <%= render "auth_nav" %>
                    </nav>
                </div>
            </header>

            <main class="about-main">
                <article class="about-content">
                    <h1>About Us</h1>

                    <h2>About NU Sublets</h2>
                    <p>
                        NU Sublets is a student-built platform designed to make the Northwestern sublet process easier, safer, and more organized.
                        Our goal is to help verified Northwestern students advertise available rooms or apartments and find housing options from other students in the community.
                    </p>
                    <p>
                        This project was created as part of a software development course and is not officially affiliated with, endorsed by, or managed by Northwestern University.
                    </p>
                </article>
            </main>

            <%= render "shared/footer" %>
        </div>
    <%= render "shared/service_worker_registration" %>

    </body>
</html>
