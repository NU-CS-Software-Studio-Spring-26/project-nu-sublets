<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Account Settings | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Rubik:wght@300;400;600&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-soft-purple: #e4c4f0;
                --nu-danger: #e11d48;
                --nu-shadow-soft: 0 0 25px rgba(217, 217, 217, 0.5);
                --nu-focus: rgba(78, 42, 132, 0.26);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
            }

            a {
                color: inherit;
            }

            img {
                display: block;
                max-width: 100%;
            }

            .settings-page {
                min-height: 100vh;
                background: #fff;
            }

            .settings-topbar {
                min-height: 74px;
                border-bottom: 1px solid var(--nu-border);
                display: flex;
                align-items: center;
                padding: 24px 64px;
            }

            .settings-topbar-inner {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 32px;
            }

            .settings-brand {
                color: var(--nu-text);
                font-size: 24px;
                font-weight: 600;
                line-height: 1;
                text-decoration: none;
                white-space: nowrap;
            }

            .settings-nav {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 64px;
                font-size: 24px;
                font-weight: 400;
                line-height: 1;
                white-space: nowrap;
            }

            .settings-nav a,
            .settings-nav button {
                color: var(--nu-text);
                text-decoration: none;
            }

            .settings-nav button {
                border: 0;
                background: transparent;
                padding: 0;
                font: inherit;
                cursor: pointer;
            }

            .settings-nav form {
                margin: 0;
            }

            .settings-main {
                display: flex;
                align-items: flex-start;
                gap: 64px;
                padding: 66px 72px 72px;
            }

            .settings-sidebar {
                width: 324px;
                min-height: 695px;
                flex: 0 0 324px;
                border-radius: 16px;
                background: #fff;
                box-shadow: var(--nu-shadow-soft);
                padding: 32px 48px;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 24px;
            }

            .settings-sidebar-title {
                margin: 0;
                font-size: 32px;
                font-weight: 600;
                line-height: 1.2;
            }

            .settings-sidebar-nav {
                width: 100%;
                display: grid;
                gap: 16px;
                font-size: 20px;
                line-height: 1.25;
            }

            .settings-sidebar-nav a {
                text-decoration: none;
            }

            .settings-sidebar-nav a[aria-current="page"] {
                font-weight: 400;
            }

            .settings-content {
                width: 504px;
                max-width: 100%;
                padding-top: 28px;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .settings-title {
                margin: 0;
                width: 307px;
                max-width: 100%;
                font-size: 32px;
                font-weight: 600;
                line-height: 1.2;
            }

            .settings-form {
                width: 100%;
                display: grid;
                gap: 16px;
            }

            .settings-field {
                display: grid;
                gap: 16px;
            }

            .settings-label {
                margin: 0;
                font-size: 20px;
                font-weight: 400;
                line-height: 1.5;
            }

            .settings-avatar {
                width: 160px;
                height: 160px;
                border-radius: 50%;
                object-fit: cover;
                background: #f4eff8;
            }

            .settings-input,
            .settings-textarea {
                width: 100%;
                border: 1px solid var(--nu-border);
                border-radius: 8px;
                background: #fff;
                color: var(--nu-text);
                font-size: 16px;
                font-weight: 300;
                line-height: 2;
                padding: 8px 16px;
            }

            .settings-input {
                height: 52px;
            }

            .settings-textarea {
                min-height: 52px;
                resize: vertical;
            }

            .settings-input:focus,
            .settings-textarea:focus,
            .settings-action:focus-visible,
            .settings-danger:focus-visible,
            .settings-sidebar-nav a:focus-visible,
            .settings-nav a:focus-visible,
            .settings-nav button:focus-visible,
            .settings-brand:focus-visible {
                outline: 3px solid var(--nu-focus);
                outline-offset: 3px;
            }

            .settings-action {
                justify-self: start;
                border: 0;
                border-radius: 4px;
                background: var(--nu-soft-purple);
                color: var(--nu-text);
                font-family: "Inter", sans-serif;
                font-size: 12px;
                font-weight: 400;
                line-height: 1;
                padding: 8px;
            }

            .settings-danger {
                color: var(--nu-danger);
                font-size: 16px;
                font-weight: 300;
                line-height: 1.2;
                text-decoration: underline;
                text-underline-offset: 2px;
            }

            @media (max-width: 991.98px) {
                .settings-topbar {
                    padding-inline: 32px;
                }

                .settings-nav {
                    gap: 28px;
                    font-size: 18px;
                }

                .settings-main {
                    gap: 32px;
                    padding: 48px 32px 56px;
                }

                .settings-sidebar {
                    width: 260px;
                    flex-basis: 260px;
                    padding-inline: 32px;
                }
            }

            @media (max-width: 767.98px) {
                .settings-topbar {
                    min-height: 64px;
                    padding: 20px 20px;
                }

                .settings-brand {
                    font-size: 20px;
                }

                .settings-nav {
                    gap: 18px;
                    font-size: 16px;
                }

                .settings-main {
                    display: grid;
                    gap: 24px;
                    padding: 28px 20px 44px;
                }

                .settings-sidebar {
                    width: 100%;
                    min-height: 0;
                    flex-basis: auto;
                    align-items: flex-start;
                    padding: 24px;
                }

                .settings-sidebar-title,
                .settings-title {
                    font-size: 28px;
                }

                .settings-sidebar-nav,
                .settings-label {
                    font-size: 18px;
                }

                .settings-content {
                    width: 100%;
                    padding-top: 0;
                }

                .settings-avatar {
                    width: 136px;
                    height: 136px;
                }
            }
        </style>
    </head>
    <body>
        <% user = current_user %>
        <% first_name = user.first_name.presence || user.display_name.split.first %>
        <% initials = user.display_name.split.map { |part| part.first }.join.first(2).upcase.presence || "NU" %>
        <% avatar_src = "https://ui-avatars.com/api/?name=#{ERB::Util.url_encode(initials)}&background=F4EFF8&color=3E1B4B&size=320&bold=true" %>
        <% bio_value = "Hi #{first_name}, this is your NU Sublets profile." %>

        <div class="settings-page">
            <header class="settings-topbar">
                <div class="settings-topbar-inner">
                    <a class="settings-brand" href="<%= root_path %>">NU-Sublets</a>
                    <nav class="settings-nav" aria-label="Primary navigation">
                        <a href="<%= search_results_path %>">Browse</a>
                        <% if user_signed_in? %>
                            <%= button_to "Log Out", session_path, method: :delete %>
                        <% else %>
                            <a href="<%= login_path %>">Log In</a>
                        <% end %>
                    </nav>
                </div>
            </header>

            <main class="settings-main">
                <aside class="settings-sidebar" aria-label="Profile navigation">
                    <h2 class="settings-sidebar-title">Profile</h2>
                    <nav class="settings-sidebar-nav">
                        <a href="<%= post_sublet_path %>">Your Listings</a>
                        <a href="<%= profile_path %>" aria-current="page">Account Settings</a>
                    </nav>
                </aside>

                <section class="settings-content" aria-label="Account settings">
                    <h1 class="settings-title">Account Settings</h1>
                    <div class="settings-form">
                        <div class="settings-field">
                            <p class="settings-label">Change Profile Picture</p>
                            <img class="settings-avatar" src="<%= avatar_src %>" alt="<%= user.display_name %> profile picture" />
                        </div>

                        <label class="settings-field">
                            <span class="settings-label">Name</span>
                            <input class="settings-input" type="text" name="name" value="<%= user.display_name %>" autocomplete="name" />
                        </label>

                        <label class="settings-field">
                            <span class="settings-label">Email</span>
                            <input class="settings-input" type="email" name="email" value="<%= user.email %>" autocomplete="email" />
                        </label>

                        <button class="settings-action" type="button">Change Password</button>

                        <label class="settings-field">
                            <span class="settings-label">Bio</span>
                            <textarea class="settings-textarea" name="bio" rows="1"><%= bio_value %></textarea>
                        </label>

                        <a class="settings-danger" href="<%= profile_path %>">Delete Account</a>
                    </div>
                </section>
            </main>
        </div>
    </body>
</html>
