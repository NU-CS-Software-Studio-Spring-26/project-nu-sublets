<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Sublet Listing | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-muted: #495057;
                --nu-accent: #4E2A84;
                --nu-card-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
                --nu-gallery-fill: #bcbcbc;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Fustat", sans-serif;
            }

            a {
                color: inherit;
            }

            .page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #d9d9d9;
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: var(--nu-text);
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .brand {
                font-weight: 400;
            }

            .nav-link {
                text-decoration: none;
            }

            .listing-page {
                padding: 1.25rem 0 4rem;
            }

            .page-container {
                max-width: 1360px;
                padding-inline: 24px;
            }

            .back-to-search {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 16px;
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                font-weight: 500;
                line-height: 1.2;
                text-decoration: none;
            }

            .back-to-search-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border: 1px solid var(--nu-border);
                border-radius: 999px;
                background: #fff;
                box-shadow: 0 5px 14px rgba(0, 0, 0, 0.08);
                transition: transform 0.2s ease, border-color 0.2s ease;
            }

            .back-to-search:hover,
            .back-to-search:focus-visible {
                color: var(--nu-text);
                outline: 0;
            }

            .back-to-search:hover .back-to-search-icon,
            .back-to-search:focus-visible .back-to-search-icon {
                border-color: var(--nu-accent);
                transform: translateX(-2px);
            }

            .gallery-main,
            .gallery-tile {
                border-radius: 8px;
                overflow: hidden;
                background: var(--nu-gallery-fill);
            }

            .gallery-main {
                height: 504px;
            }

            .gallery-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                grid-template-rows: 1fr 1fr;
                gap: 1rem;
                height: 504px;
            }

            .gallery-tile {
                height: 100%;
            }

            .gallery-photo {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .gallery-button {
                display: block;
                width: 100%;
                height: 100%;
                padding: 0;
                border: 0;
                background: transparent;
            }

            .gallery-button:focus-visible {
                outline: 3px solid var(--nu-accent);
                outline-offset: 3px;
            }

            .image-popup {
                position: fixed;
                inset: 0;
                z-index: 2000;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .image-popup.is-open {
                display: flex;
            }

            .image-popup__backdrop {
                position: absolute;
                inset: 0;
                background: rgba(0, 0, 0, 0.78);
            }

            .image-popup__dialog {
                position: relative;
                max-width: min(1080px, 92vw);
                max-height: 88vh;
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
                overflow: hidden;
            }

            .image-popup__image {
                display: block;
                max-width: 100%;
                max-height: 88vh;
                object-fit: contain;
            }

            body.image-popup-open {
                overflow: hidden;
            }

            .listing-alert {
                margin: 0 0 1rem;
                padding: 0.75rem 1rem;
                border-radius: 6px;
                font-family: "Rubik", sans-serif;
                font-size: 0.9rem;
            }

            .listing-alert.notice {
                border: 1px solid #bbf7d0;
                background: #f0fdf4;
                color: #166534;
            }

            .listing-alert.alert {
                border: 1px solid #fecaca;
                background: #fef2f2;
                color: #991b1b;
            }

            .report-listing-button {
                min-height: 40px;
                border-color: var(--nu-border);
                color: var(--nu-text);
                font-family: "Rubik", sans-serif;
            }

            .report-listing-button:hover,
            .report-listing-button:focus-visible {
                border-color: var(--nu-accent);
                color: var(--nu-accent);
            }

            .report-listing-button:disabled {
                opacity: 0.62;
                cursor: not-allowed;
            }

            .report-modal {
                position: fixed;
                inset: 0;
                z-index: 2600;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity 0.2s ease, visibility 0.2s ease;
            }

            .report-modal.is-open {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            .report-modal__backdrop {
                position: absolute;
                inset: 0;
                background: rgba(17, 12, 20, 0.34);
                backdrop-filter: blur(3px);
            }

            .report-modal__dialog {
                position: relative;
                z-index: 1;
                width: min(100%, 600px);
                padding: 32px 48px;
                border-radius: 16px;
                background: #fff;
                box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
            }

            .report-modal__close {
                position: absolute;
                top: 16px;
                right: 16px;
                width: 36px;
                height: 36px;
                border: 0;
                border-radius: 999px;
                background: transparent;
                color: #5f5f5f;
                font-size: 24px;
                line-height: 1;
            }

            .report-modal__title {
                margin: 0 0 16px;
                font-family: "Rubik", sans-serif;
                font-size: 20px;
                font-weight: 400;
                line-height: 1.5;
            }

            .report-modal__textarea {
                display: block;
                width: 100%;
                min-height: 234px;
                margin-bottom: 16px;
                padding: 8px 16px;
                border: 1px solid #d9d9d9;
                border-radius: 8px;
                color: #000;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 300;
                line-height: 2;
                resize: vertical;
            }

            .report-modal__textarea:focus-visible {
                border-color: var(--nu-accent);
                outline: 3px solid rgba(78, 42, 132, 0.18);
            }

            .report-modal__submit {
                width: 100%;
                min-height: 56px;
                border: 0;
                border-radius: 16px;
                background: #9c51b6;
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 600;
                line-height: 1.5;
            }

            .report-modal__submit:hover,
            .report-modal__submit:focus-visible {
                background: #8e45aa;
            }

            body.report-modal-open {
                overflow: hidden;
            }

            .listing-heading-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .listing-heading-copy {
                min-width: min(100%, 320px);
                flex: 1 1 420px;
            }

            .listing-title {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: clamp(1.8rem, 3.5vw, 2.5rem);
                font-weight: 800;
                line-height: 1.1;
            }

            .listing-price {
                margin: 0.45rem 0 0;
                font-family: "Rubik", sans-serif;
                font-size: 1.35rem;
                font-weight: 700;
                line-height: 1.2;
            }

            .host-row {
                display: inline-flex;
                align-items: center;
                gap: 0.75rem;
                margin-top: 0.6rem;
                color: inherit;
                text-decoration: none;
            }

            .host-row[href]:hover .host-name,
            .host-row[href]:focus-visible .host-name {
                color: var(--nu-accent);
                text-decoration: underline;
            }

            .host-row[href]:focus-visible {
                border-radius: 8px;
                outline: 3px solid rgba(78, 42, 132, 0.28);
                outline-offset: 5px;
            }

            .listing-address {
                margin-top: 0.45rem;
                font-family: "Rubik", sans-serif;
                font-size: 1rem;
                font-weight: 400;
                line-height: 1.35;
                color: var(--nu-muted);
            }

            .host-avatar {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                object-fit: cover;
            }

            .host-name {
                font-family: "Rubik", sans-serif;
                font-size: clamp(1.05rem, 2vw, 1.35rem);
                line-height: 1.1;
            }

            .verified-badge {
                width: 34px;
                height: 34px;
            }

            .description-copy {
                max-width: 46rem;
                margin-top: 1rem;
                font-size: 1rem;
                line-height: 2;
            }

            .listing-copy-column {
                padding-left: 1.75rem;
            }

            .listing-offset-section {
                padding-left: 1.75rem;
            }

            .info-card {
                border: 0;
                border-radius: 26px;
                box-shadow: var(--nu-card-shadow);
            }

            .availability-card {
                width: 100%;
                max-width: 435px;
                margin-left: 0.75rem;
            }

            .contact-card {
                width: 100%;
                max-width: 435px;
                margin: 1.75rem 0 0 0.75rem;
            }

            .listing-sidebar {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
            }

            .card-title,
            .section-title {
                font-family: "Rubik", sans-serif;
                font-weight: 600;
                color: var(--nu-text);
            }

            .card-title {
                font-size: 1.5rem;
            }

            .section-title {
                margin-bottom: 1rem;
                font-size: 1.5rem;
            }

            .availability-label {
                font-family: "Rubik", sans-serif;
                font-size: 1.25rem;
                font-weight: 500;
                margin-bottom: 1rem;
            }

            .availability-range {
                display: flex;
                align-items: center;
                gap: 1.8rem;
                font-size: 1rem;
            }

            .arrow-icon {
                width: 24px;
                height: 24px;
                flex: 0 0 auto;
            }

            .arrow-icon,
            .contact-icon,
            .amenity-icon,
            .verified-badge {
                display: inline-block;
                vertical-align: middle;
            }

            .contact-grid {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 1.15rem 2rem;
                align-items: center;
            }

            .contact-label {
                display: inline-flex;
                align-items: center;
                gap: 1rem;
                font-family: "Rubik", sans-serif;
                font-size: 1rem;
            }

            .contact-icon {
                width: 24px;
                height: 24px;
            }

            .contact-link {
                color: var(--nu-accent);
                font-size: 0.95rem;
                text-decoration: none;
                word-break: break-word;
            }

            .contact-link:hover,
            .contact-link:focus-visible {
                text-decoration: underline;
            }

            .amenities-row {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem 2rem;
            }

            .amenity,
            .preference {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                font-family: "Rubik", sans-serif;
                font-size: 1rem;
                font-weight: 500;
            }

            .amenity-icon {
                width: 32px;
                height: 32px;
            }

            .preferences-row {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem 2rem;
            }

            .questions-section {
                max-width: 900px;
            }

            .questions-header {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1rem;
            }

            .questions-count {
                color: var(--nu-muted);
                font-family: "Rubik", sans-serif;
                font-size: 0.9rem;
                line-height: 1.2;
            }

            .question-form,
            .question-item {
                border: 1px solid var(--nu-border);
                border-radius: 8px;
                background: #fff;
            }

            .question-form {
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .question-label,
            .answer-label {
                display: block;
                margin-bottom: 0.45rem;
                font-family: "Rubik", sans-serif;
                font-size: 0.9rem;
                font-weight: 600;
            }

            .question-textarea,
            .answer-textarea {
                width: 100%;
                min-height: 96px;
                padding: 0.75rem;
                border: 1px solid var(--nu-border);
                border-radius: 6px;
                color: var(--nu-text);
                font: inherit;
                line-height: 1.5;
                resize: vertical;
            }

            .question-textarea:focus-visible,
            .answer-textarea:focus-visible {
                border-color: var(--nu-accent);
                outline: 3px solid rgba(78, 42, 132, 0.18);
            }

            .question-actions {
                display: flex;
                justify-content: flex-end;
                gap: 0.75rem;
                margin-top: 0.75rem;
            }

            .questions-list {
                display: grid;
                gap: 1rem;
            }

            .question-item {
                padding: 1rem;
            }

            .question-meta,
            .answer-meta {
                margin: 0 0 0.45rem;
                color: var(--nu-muted);
                font-family: "Rubik", sans-serif;
                font-size: 0.82rem;
                line-height: 1.3;
            }

            .question-body,
            .answer-body {
                margin: 0;
                line-height: 1.6;
            }

            .answer-block {
                margin-top: 1rem;
                padding: 0.9rem;
                border-left: 4px solid var(--nu-accent);
                border-radius: 0 6px 6px 0;
                background: #f8f5fb;
            }

            .answer-form {
                margin-top: 1rem;
            }

            .question-delete-form {
                margin-top: 0.75rem;
            }

            .question-empty,
            .question-auth-note,
            .question-owner-note {
                margin: 0 0 1rem;
                color: var(--nu-muted);
                line-height: 1.5;
            }

            .question-alert {
                margin: 0 0 1rem;
                padding: 0.75rem 1rem;
                border-radius: 6px;
                font-family: "Rubik", sans-serif;
                font-size: 0.9rem;
            }

            .question-alert.notice {
                border: 1px solid #bbf7d0;
                background: #f0fdf4;
                color: #166534;
            }

            .question-alert.alert {
                border: 1px solid #fecaca;
                background: #fef2f2;
                color: #991b1b;
            }

            @media (max-width: 991.98px) {
                .brand,
                .nav-link {
                    font-size: 16px;
                }

                .listing-page {
                    padding-top: 1rem;
                }

                .gallery-main {
                    height: 400px;
                }

                .gallery-grid {
                    gap: 0.75rem;
                }

                .gallery-tile {
                    height: 188px;
                }

                .availability-card,
                .contact-card {
                    max-width: none;
                    margin-left: 0;
                }

                .listing-sidebar {
                    align-items: stretch;
                }

                .listing-copy-column {
                    padding-left: calc(var(--bs-gutter-x) * 0.5);
                }

                .listing-offset-section {
                    padding-left: 0;
                }
            }

            @media (max-width: 767.98px) {
                .topbar {
                    padding-inline: 16px;
                }

                .topbar-nav {
                    gap: 20px;
                }

                .brand,
                .nav-link {
                    font-size: 14px;
                }

                .page-container {
                    padding-inline: 24px;
                }

                .gallery-main {
                    height: 280px;
                }

                .gallery-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.5rem;
                }

                .gallery-tile {
                    height: 132px;
                }

                .image-popup {
                    padding: 16px;
                }

                .image-popup__dialog,
                .image-popup__image {
                    max-height: 82vh;
                }

                .report-modal {
                    padding: 16px;
                }

                .report-modal__dialog {
                    padding: 28px 20px 24px;
                }

                .host-row {
                    align-items: flex-start;
                    flex-wrap: wrap;
                }

                .description-copy {
                    font-size: 0.875rem;
                    line-height: 1.85;
                }

                .availability-range {
                    gap: 0.85rem;
                    flex-wrap: wrap;
                }

                .contact-grid {
                    grid-template-columns: 1fr;
                    gap: 0.75rem;
                }

                .contact-label {
                    font-size: 0.9rem;
                }

                .contact-link,
                .amenity,
                .preference {
                    font-size: 0.875rem;
                }

                .card-title,
                .section-title {
                    font-size: 1.25rem;
                }

                .questions-header {
                    display: block;
                }
            }
        </style>
        <%= render "focus_styles" %>
    <%= render "shared/pwa_meta" %>

    </head>
    <body>
        <% host_name = @listing_host.display_name || @listing_host.name || "Listing Host" %>
        <% host_email = @listing_host.email.presence || "janedoe@u.northwestern.edu" %>
        <% host_avatar_url = user_avatar_url(@listing_host, size: 100) %>
        <% host_profile_path = @listing_host.persisted? ? user_profile_path(@listing_host) : nil %>
        <% amenities = @listing.displayed_amenities %>
        <% amenities = ["Ask host for amenity details"] if amenities.empty? %>
        <% preferences = @listing.displayed_preferences %>
        <% preferences = ["Ask host for roommate preferences"] if preferences.empty? %>
        <% gallery_images = apartment_gallery_image_paths(@listing) %>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <%= render 'shared/brand_logo' %>
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>"><%= nav_item_label_with_icon(:browse, "Browse") %></a>
                        <a class="nav-link p-0" href="<%= search_results_path %>"><%= nav_item_label_with_icon(:search, "Search") %></a>
                        <a class="nav-link p-0" href="<%= saved_path %>"><%= nav_item_label_with_icon(:saved, "Saved") %></a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>"><%= nav_item_label_with_icon(:post_sublet, "Post Sublet") %></a>
                        <%= render "auth_nav" %>
                    </nav>
                </div>
            </header>

            <main class="listing-page">
                <div class="container-fluid page-container">
                    <a class="back-to-search" href="<%= search_results_path %>" aria-label="Back to search results">
                        <span class="back-to-search-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M15 6 9 12l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span>Back to search results</span>
                    </a>

                    <% flash.each do |type, message| %>
                        <p class="listing-alert <%= type %>" role="alert"><%= message %></p>
                    <% end %>

                    <section class="row g-3 g-lg-4 align-items-stretch">
                        <div class="col-lg-6">
                            <div class="gallery-main">
                                <button class="gallery-button" type="button" data-image-popup-trigger>
                                    <img class="gallery-photo" src="<%= gallery_images[0] %>" alt="Main view of the sublet near Northwestern University" />
                                </button>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="gallery-grid">
                                <div class="gallery-tile">
                                    <button class="gallery-button" type="button" data-image-popup-trigger>
                                        <img class="gallery-photo" src="<%= gallery_images[1] %>" alt="Living space view of the sublet" />
                                    </button>
                                </div>
                                <div class="gallery-tile">
                                    <button class="gallery-button" type="button" data-image-popup-trigger>
                                        <img class="gallery-photo" src="<%= gallery_images[2] %>" alt="Kitchen view of the apartment" />
                                    </button>
                                </div>
                                <div class="gallery-tile">
                                    <button class="gallery-button" type="button" data-image-popup-trigger>
                                        <img class="gallery-photo" src="<%= gallery_images[3] %>" alt="Bedroom area in the apartment" />
                                    </button>
                                </div>
                                <div class="gallery-tile">
                                    <button class="gallery-button" type="button" data-image-popup-trigger>
                                        <img class="gallery-photo" src="<%= gallery_images[0] %>" alt="Exterior neighborhood photo near the sublet" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="row g-3 g-lg-4 pt-3 pt-lg-4">
                        <div class="col-lg-7 col-xl-7 listing-copy-column">
                            <div class="listing-heading-row">
                                <div class="listing-heading-copy">
                                    <h1 class="listing-title"><%= @listing.title %></h1>
                                    <p class="listing-price"><%= number_to_currency(@listing.price, precision: 0) %>/month</p>
                                    <p class="listing-address"><%= @listing.address %></p>
                                </div>

                                <% if @listing.persisted? %>
                                    <% if user_signed_in? %>
                                        <button class="btn btn-outline-secondary report-listing-button" type="button" data-report-modal-trigger aria-haspopup="dialog">
                                            Report listing
                                        </button>
                                    <% else %>
                                        <a class="btn btn-outline-secondary report-listing-button" href="#" data-login-trigger>
                                            Report listing
                                        </a>
                                    <% end %>
                                <% else %>
                                    <button class="btn btn-outline-secondary report-listing-button" type="button" disabled title="Reports are available for posted listings.">
                                        Report listing
                                    </button>
                                <% end %>
                            </div>
                            <% if host_profile_path %>
                                <a class="host-row" href="<%= host_profile_path %>" aria-label="View <%= host_name %>'s profile">
                            <% else %>
                                <div class="host-row">
                            <% end %>
                                <img class="host-avatar" src="<%= host_avatar_url %>" alt="<%= host_name %> profile photo" />
                                <div class="host-name"><%= host_name %></div>
                                <svg class="verified-badge" viewBox="0 0 48 48" aria-label="Verified listing badge" role="img">
                                    <path
                                        d="M24 3.75 9.75 9v12.49c0 10.23 6.07 19.8 14.25 22.76 8.18-2.96 14.25-12.53 14.25-22.76V9L24 3.75Z"
                                        fill="none"
                                        stroke="#3B82F6"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2.5"
                                    />
                                    <path d="m16.5 24.38 5.25 5.25L31.5 18.38" fill="none" stroke="#3B82F6" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" />
                                </svg>
                            <% if host_profile_path %>
                                </a>
                            <% else %>
                                </div>
                            <% end %>

                            <p class="description-copy"><%= @listing.description %></p>
                        </div>

                        <aside class="col-lg-5 col-xl-5 listing-sidebar" aria-label="Listing availability and contact">
                            <div class="card info-card availability-card">
                                <div class="card-body p-4 p-xl-5">
                                    <div class="availability-label">Available from:</div>
                                    <div class="availability-range">
                                        <span><%= @listing.available_from.strftime("%B %-d, %Y") %></span>
                                        <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M4 12h13.5m0 0-5-5m5 5-5 5" fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                                        </svg>
                                        <span><%= @listing.available_until.strftime("%B %-d, %Y") %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card info-card contact-card">
                                <div class="card-body p-4 p-xl-5">
                                    <h2 class="card-title mb-4">Contact <%= host_name.split.first || host_name %></h2>
                                    <div class="contact-grid">
                                        <div class="contact-label">
                                            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path
                                                    d="M20.3 15.3c-1.2 0-2.3-.2-3.3-.7-.3-.1-.7-.1-1 .2l-2.1 2.1c-2.7-1.4-4.8-3.5-6.2-6.2l2.1-2.1c.3-.3.4-.7.2-1-.4-1-.7-2.1-.7-3.3 0-.6-.4-1-1-1H4.5c-.6 0-1 .4-1 1C3.5 14 10 20.5 18.7 20.5c.6 0 1-.4 1-1v-3.2c0-.6-.4-1-1-1Z"
                                                    fill="none"
                                                    stroke="#000"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1.7"
                                                />
                                            </svg>
                                            <span>Phone:</span>
                                        </div>
                                        <a class="contact-link" href="tel:+11234567890">+1 (123) 456-7890</a>

                                        <div class="contact-label">
                                            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M3.75 6.75h16.5v10.5H3.75z" fill="none" stroke="#000" stroke-linejoin="round" stroke-width="1.7" />
                                                <path d="m4.75 7.75 7.25 5.5 7.25-5.5" fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
                                            </svg>
                                            <span>Email:</span>
                                        </div>
                                        <a class="contact-link" href="mailto:<%= host_email %>"><%= host_email %></a>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap mt-4">
                                        <% if user_signed_in? %>
                                            <a class="btn btn-primary" href="mailto:<%= host_email %>">Email Host</a>
                                            <a class="btn btn-outline-secondary" href="tel:+11234567890">Call Host</a>
                                        <% else %>
                                            <a class="btn btn-primary" href="#" data-login-trigger>Email Host</a>
                                            <a class="btn btn-outline-secondary" href="#" data-login-trigger>Call Host</a>
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        </aside>
                    </section>

                    <section class="pt-4 listing-offset-section">
                        <h2 class="section-title">Listing Details</h2>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Category</th>
                                        <th scope="col">Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row">Rent</th>
                                        <td><%= number_to_currency(@listing.price, precision: 0) %>/month<%= ", utilities included" if @listing.utilities_included %></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Lease Window</th>
                                        <td><%= @listing.available_from.strftime("%B %-d, %Y") %> to <%= @listing.available_until.strftime("%B %-d, %Y") %></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Location</th>
                                        <td><%= @listing.address %></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Unit Type</th>
                                        <td><%= pluralize(@listing.bedrooms, "bedroom") %>, <%= pluralize(@listing.bathrooms, "bathroom") %><%= @listing.furnished ? ", furnished" : "" %></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Amenities</th>
                                        <td><%= amenities.join(", ") %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="pt-4 pt-lg-2 listing-offset-section">
                        <h2 class="section-title">Amenities</h2>
                        <div class="amenities-row">
                            <% amenities.first(6).each do |amenity| %>
                                <div class="amenity">
                                    <svg class="amenity-icon" viewBox="0 0 32 32" aria-hidden="true">
                                        <path d="M6 8h20v16H6zM10 8V5m12 3V5M10 16h12" fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                                    </svg>
                                    <span><%= amenity %></span>
                                </div>
                            <% end %>
                        </div>
                    </section>

                    <section class="pt-5 listing-offset-section">
                        <h2 class="section-title">Preferences</h2>
                        <div class="preferences-row">
                            <% preferences.each do |preference| %>
                                <div class="preference"><%= preference %></div>
                            <% end %>
                        </div>
                    </section>

                    <section class="pt-5 listing-offset-section questions-section" id="questions" aria-labelledby="questions-title">
                        <% listing_owner = user_signed_in? && current_user.id == @listing.user_id %>
                        <div class="questions-header">
                            <h2 class="section-title" id="questions-title">Questions &amp; Answers</h2>
                            <span class="questions-count"><%= pluralize(@listing_questions.size, "question") %></span>
                        </div>

                        <% flash.each do |type, message| %>
                            <p class="question-alert <%= type %>" role="alert"><%= message %></p>
                        <% end %>

                        <% if user_signed_in? && @listing.persisted? && !listing_owner %>
                            <%= form_with model: @listing_question, url: sublet_listing_questions_path(@listing), method: :post, local: true, class: "question-form" do |form| %>
                                <%= form.label :body, "Ask the host a question", class: "question-label" %>
                                <%= form.text_area :body, class: "question-textarea", maxlength: ListingQuestion::MAX_BODY_LENGTH, required: true, placeholder: "Ask about utilities, move-in details, roommates, parking, or anything else students should know." %>
                                <div class="question-actions">
                                    <%= form.submit "Post question", class: "btn btn-primary" %>
                                </div>
                            <% end %>
                        <% elsif user_signed_in? && listing_owner %>
                            <p class="question-owner-note">You own this listing. Answer renter questions below so everyone can see the details.</p>
                        <% elsif @listing.persisted? %>
                            <p class="question-auth-note"><%= link_to "Log in", login_path %> to ask the host a public question.</p>
                        <% end %>

                        <% if @listing_questions.any? %>
                            <div class="questions-list">
                                <% @listing_questions.each do |question| %>
                                    <% asker_name = question.user&.display_name || "Student" %>
                                    <article class="question-item">
                                        <p class="question-meta">Asked by <%= asker_name %> on <%= question.created_at.strftime("%b %-d, %Y") %></p>
                                        <p class="question-body"><%= question.body %></p>

                                        <% if question.answered? %>
                                            <div class="answer-block">
                                                <p class="answer-meta">Answered by <%= host_name %><%= " on #{question.answered_at.strftime("%b %-d, %Y")}" if question.answered_at.present? %></p>
                                                <p class="answer-body"><%= question.answer %></p>
                                            </div>
                                        <% end %>

                                        <% if listing_owner %>
                                            <%= form_with model: question, url: listing_question_path(question), method: :patch, local: true, class: "answer-form" do |form| %>
                                                <%= form.label :answer, question.answered? ? "Update answer" : "Answer this question", class: "answer-label" %>
                                                <%= form.text_area :answer, class: "answer-textarea", maxlength: ListingQuestion::MAX_ANSWER_LENGTH, required: true, value: question.answer %>
                                                <div class="question-actions">
                                                    <%= form.submit question.answered? ? "Update answer" : "Post answer", class: "btn btn-primary" %>
                                                </div>
                                            <% end %>
                                        <% end %>

                                        <% if user_signed_in? && (listing_owner || question.user_id == current_user.id) %>
                                            <%= button_to "Delete question", listing_question_path(question), method: :delete, class: "btn btn-outline-danger btn-sm", form: { class: "question-delete-form" } %>
                                        <% end %>
                                    </article>
                                <% end %>
                            </div>
                        <% else %>
                            <p class="question-empty">No questions yet. Ask something useful for everyone considering this sublet.</p>
                        <% end %>
                    </section>
                </div>
            </main>
            <%= render "shared/footer" %>
        </div>

        <div class="image-popup" data-image-popup aria-hidden="true">
            <div class="image-popup__backdrop" data-image-popup-close></div>
            <div class="image-popup__dialog" role="dialog" aria-modal="true" aria-label="Enlarged listing image">
                <img class="image-popup__image" src="" alt="" data-image-popup-image />
            </div>
        </div>

        <% if user_signed_in? && @listing.persisted? %>
            <div id="report-modal" class="report-modal" data-report-modal aria-hidden="true">
                <div class="report-modal__backdrop" data-report-modal-close></div>
                <div class="report-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="report-modal-title">
                    <button class="report-modal__close" type="button" aria-label="Close report popup" data-report-modal-close>&times;</button>
                    <h2 class="report-modal__title" id="report-modal-title">Report Listing</h2>

                    <%= form_with model: @listing_report, url: sublet_listing_reports_path(@listing), method: :post, local: true do |form| %>
                        <%= form.text_area :description,
                                           class: "report-modal__textarea",
                                           maxlength: ListingReport::MAX_DESCRIPTION_LENGTH,
                                           required: true,
                                           placeholder: "Description",
                                           aria: { label: "Describe the policy concern" } %>
                        <%= form.submit "Send Report", class: "report-modal__submit" %>
                    <% end %>
                </div>
            </div>
        <% end %>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        ></script>
        <script>
            (() => {
                const popup = document.querySelector("[data-image-popup]");
                const popupImage = document.querySelector("[data-image-popup-image]");
                const closeButtons = document.querySelectorAll("[data-image-popup-close]");
                const triggers = document.querySelectorAll("[data-image-popup-trigger]");

                if (!popup || !popupImage || triggers.length === 0) {
                    return;
                }

                const openPopup = (image) => {
                    popupImage.src = image.currentSrc || image.src;
                    popupImage.alt = image.alt || "Enlarged listing image";
                    popup.classList.add("is-open");
                    popup.setAttribute("aria-hidden", "false");
                    document.body.classList.add("image-popup-open");
                };

                const closePopup = () => {
                    popup.classList.remove("is-open");
                    popup.setAttribute("aria-hidden", "true");
                    document.body.classList.remove("image-popup-open");
                    popupImage.src = "";
                    popupImage.alt = "";
                };

                triggers.forEach((trigger) => {
                    trigger.addEventListener("click", () => {
                        const image = trigger.querySelector(".gallery-photo");

                        if (image) {
                            openPopup(image);
                        }
                    });
                });

                closeButtons.forEach((button) => {
                    button.addEventListener("click", closePopup);
                });

                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && popup.classList.contains("is-open")) {
                        closePopup();
                    }
                });
            })();
        </script>
        <script>
            (() => {
                const modal = document.querySelector("[data-report-modal]");
                const triggers = document.querySelectorAll("[data-report-modal-trigger]");

                if (!modal || triggers.length === 0 || modal.dataset.reportBound === "true") {
                    return;
                }

                modal.dataset.reportBound = "true";
                let activeTrigger = null;

                const openModal = (trigger) => {
                    activeTrigger = trigger;
                    modal.classList.add("is-open");
                    modal.setAttribute("aria-hidden", "false");
                    document.body.classList.add("report-modal-open");
                    modal.querySelector(".report-modal__textarea")?.focus();
                };

                const closeModal = () => {
                    modal.classList.remove("is-open");
                    modal.setAttribute("aria-hidden", "true");
                    document.body.classList.remove("report-modal-open");
                    activeTrigger?.focus();
                };

                triggers.forEach((trigger) => {
                    trigger.addEventListener("click", () => openModal(trigger));
                });

                modal.querySelectorAll("[data-report-modal-close]").forEach((closeButton) => {
                    closeButton.addEventListener("click", closeModal);
                });

                modal.addEventListener("click", (event) => {
                    if (event.target === modal) {
                        closeModal();
                    }
                });

                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && modal.classList.contains("is-open")) {
                        closeModal();
                    }
                });
            })();
        </script>
        <%= render "login_modal" %>
        <%= render "shared/skeleton_loaders" %>
    <%= render "shared/service_worker_registration" %>

    </body>
</html>
