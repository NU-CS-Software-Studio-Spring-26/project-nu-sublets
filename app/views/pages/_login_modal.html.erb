<style>
    .login-modal {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .login-modal.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .login-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(17, 12, 20, 0.34);
        backdrop-filter: blur(3px);
    }

    .login-modal__dialog {
        position: relative;
        width: min(100%, 600px);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
        padding: 32px 48px;
        z-index: 1;
    }

    .login-modal__close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #5f5f5f;
        font-size: 24px;
        line-height: 1;
    }

    .login-modal__title {
        margin: 0 0 16px;
        font-family: "Rubik", sans-serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.5;
    }

    .login-modal__form,
    .login-modal__actions {
        display: grid;
        gap: 16px;
    }

    .login-modal__field,
    .login-modal__social {
        width: 100%;
        min-height: 52px;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        background: #ffffff;
        color: #000000;
        font-family: "Rubik", sans-serif;
        font-size: 16px;
        line-height: 2;
    }

    .login-modal__field {
        padding: 8px 16px;
    }

    .password-input-wrap {
        position: relative;
        width: 100%;
    }

    .password-input-wrap .login-modal__field {
        padding-right: 52px;
    }

    .password-visibility-toggle {
        position: absolute;
        top: 50%;
        right: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 4px;
        background: transparent;
        color: #5b5b5b;
        transform: translateY(-50%);
        cursor: pointer;
    }

    .password-visibility-toggle:hover,
    .password-visibility-toggle:focus-visible {
        color: #4E2A84;
        outline: 3px solid rgba(78, 42, 132, 0.26);
    }

    .password-visibility-toggle svg {
        width: 20px;
        height: 20px;
        display: block;
    }

    .password-visibility-toggle .eye-off-icon {
        display: none;
    }

    .password-visibility-toggle[aria-pressed="true"] .eye-icon {
        display: none;
    }

    .password-visibility-toggle[aria-pressed="true"] .eye-off-icon {
        display: block;
    }

    .login-modal__field::placeholder {
        color: #6b7280;
        opacity: 1;
    }

    .login-modal__submit {
        width: 100%;
        border: 0;
        border-radius: 16px;
        background: #4E2A84;
        color: #ffffff;
        font-family: "Rubik", sans-serif;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.5;
        padding: 16px 10px;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .login-modal__submit:hover,
    .login-modal__submit:focus-visible,
    .login-modal__social:hover,
    .login-modal__social:focus-visible {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .login-modal__signup {
        margin: 0;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 2;
        text-align: center;
    }

    .login-modal__error {
        display: none;
        margin: 0;
        border-radius: 8px;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 10px 12px;
    }

    .login-modal__error:not(:empty) {
        display: block;
    }

    .login-modal__error.is-error {
        background: #fff3f3;
        color: #9f1d1d;
    }

    .login-modal__error.is-success {
        background: #ecfdf3;
        color: #166534;
    }

    .login-modal__oauth-note {
        margin: 0;
        border-radius: 8px;
        background: #fff8e1;
        color: #5f4300;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 10px 12px;
    }

    .login-modal__signup-link {
        color: #4E2A84;
        text-decoration: underline;
    }

    .login-modal__divider {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .login-modal__divider::before,
    .login-modal__divider::after {
        content: "";
        flex: 1 1 auto;
        border-top: 1px solid #000000;
    }

    .login-modal__divider-text {
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 2;
    }

    .login-modal__social {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 8px 16px;
        text-align: left;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .login-modal__icon {
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .login-modal__trigger {
        border: 1px solid #d9d9d9;
        border-radius: 999px;
        padding: 8px 16px;
        font-family: "Rubik", sans-serif;
        line-height: 1.2;
    }

    body.login-modal-open {
        overflow: hidden;
    }

    @media (max-width: 767.98px) {
        .login-modal {
            padding: 16px;
        }

        .login-modal__dialog {
            padding: 28px 20px 24px;
        }
    }
</style>

<div
    id="login-modal"
    class="login-modal"
    data-login-modal
    aria-hidden="true"
>
    <div class="login-modal__backdrop" data-login-close></div>
    <div class="login-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="login-modal-title">
        <button class="login-modal__close" type="button" aria-label="Close login popup" data-login-close>&times;</button>
        <h2 class="login-modal__title" id="login-modal-title">Login</h2>

        <%= form_with url: session_path, method: :post, local: true, class: "login-modal__form" do %>
            <%= email_field_tag :email, nil, class: "login-modal__field", placeholder: "Northwestern email", autocomplete: "email", required: true %>
            <div class="password-input-wrap">
                <%= password_field_tag :password, nil, class: "login-modal__field", placeholder: "Password", autocomplete: "current-password", required: true, data: { password_toggle_input: true } %>
                <%= render "shared/password_visibility_toggle" %>
            </div>
            <%= submit_tag "Log in", class: "login-modal__submit" %>
        <% end %>

        <div class="login-modal__divider" aria-hidden="true">
            <span class="login-modal__divider-text">or</span>
        </div>

        <%= button_to "Sign in with Google",
                      google_oauth_configured? ? "/auth/google_oauth2" : google_oauth_path,
                      method: :post,
                      class: "login-modal__social",
                      data: { turbo: false } %>

        <p class="login-modal__signup">
            Need an account?
            <%= link_to "Sign up", signup_path, class: "login-modal__signup-link" %>
        </p>
    </div>
</div>

<script>
    (() => {
        const modal = document.querySelector("[data-login-modal]");

        if (!modal || modal.dataset.loginBound === "true") {
            return;
        }

        modal.dataset.loginBound = "true";
        const openModal = () => {
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("login-modal-open");
        };

        const closeModal = () => {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("login-modal-open");
        };

        document.querySelectorAll("[data-login-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", (event) => {
                event.preventDefault();
                openModal();
            });
        });

        modal.querySelectorAll("[data-login-close]").forEach((closeButton) => {
            closeButton.addEventListener("click", closeModal);
        });

        modal.addEventListener("click", (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && modal.classList.contains("is-open")) {
                closeModal();
            }
        });

        modal.querySelectorAll("[data-password-toggle]").forEach((toggle) => {
            const input = toggle.closest(".password-input-wrap")?.querySelector("[data-password-toggle-input]");

            toggle.addEventListener("click", () => {
                if (!input) {
                    return;
                }

                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";
                toggle.setAttribute("aria-pressed", String(isPassword));
                toggle.setAttribute("aria-label", isPassword ? "Hide password" : "Show password");
            });
        });
    })();
</script>
