<style>
    .login-modal {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .login-modal.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .login-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(17, 12, 20, 0.34);
        backdrop-filter: blur(3px);
    }

    .login-modal__dialog {
        position: relative;
        width: min(100%, 600px);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
        padding: 32px 48px;
        z-index: 1;
    }

    .login-modal__close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #5f5f5f;
        font-size: 24px;
        line-height: 1;
    }

    .login-modal__title {
        margin: 0 0 16px;
        font-family: "Rubik", sans-serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.5;
    }

    .login-modal__form,
    .login-modal__actions {
        display: grid;
        gap: 16px;
    }

    .login-modal__field,
    .login-modal__social {
        width: 100%;
        min-height: 52px;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        background: #ffffff;
        color: #000000;
        font-family: "Rubik", sans-serif;
        font-size: 16px;
        line-height: 2;
    }

    .login-modal__field {
        padding: 8px 16px;
    }

    .login-modal__field::placeholder {
        color: #000000;
        opacity: 1;
    }

    .login-modal__submit {
        width: 100%;
        border: 0;
        border-radius: 16px;
        background: #9c51b6;
        color: #ffffff;
        font-family: "Rubik", sans-serif;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.5;
        padding: 16px 10px;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .login-modal__submit:hover,
    .login-modal__submit:focus-visible,
    .login-modal__social:hover,
    .login-modal__social:focus-visible {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .login-modal__signup {
        margin: 0;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 2;
        text-align: center;
    }

    .login-modal__error {
        display: none;
        margin: 0;
        border-radius: 8px;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 10px 12px;
    }

    .login-modal__error:not(:empty) {
        display: block;
    }

    .login-modal__error.is-error {
        background: #fff3f3;
        color: #9f1d1d;
    }

    .login-modal__error.is-success {
        background: #ecfdf3;
        color: #166534;
    }

    .login-modal__signup-link {
        color: #9c51b6;
        text-decoration: underline;
    }

    .login-modal__divider {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .login-modal__divider::before,
    .login-modal__divider::after {
        content: "";
        flex: 1 1 auto;
        border-top: 1px solid #000000;
    }

    .login-modal__divider-text {
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 2;
    }

    .login-modal__social {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 8px 16px;
        text-align: left;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .login-modal__icon {
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .login-modal__trigger {
        border: 1px solid #d9d9d9;
        border-radius: 999px;
        padding: 8px 16px;
        font-family: "Rubik", sans-serif;
        line-height: 1.2;
    }

    body.login-modal-open {
        overflow: hidden;
    }

    @media (max-width: 767.98px) {
        .login-modal {
            padding: 16px;
        }

        .login-modal__dialog {
            padding: 28px 20px 24px;
        }
    }
</style>

<div
    class="login-modal"
    data-login-modal
    data-firebase-api-key="<%= ENV["FIREBASE_API_KEY"] %>"
    data-firebase-auth-domain="<%= ENV["FIREBASE_AUTH_DOMAIN"] %>"
    data-firebase-project-id="<%= ENV["FIREBASE_PROJECT_ID"] %>"
    data-firebase-app-id="<%= ENV["FIREBASE_APP_ID"] %>"
    data-session-url="<%= session_path %>"
    data-csrf-token="<%= form_authenticity_token %>"
    aria-hidden="true"
>
    <div class="login-modal__backdrop" data-login-close></div>
    <div class="login-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="login-modal-title">
        <button class="login-modal__close" type="button" aria-label="Close login popup" data-login-close>&times;</button>
        <h2 class="login-modal__title" id="login-modal-title">Login</h2>

        <p class="login-modal__error" data-login-error role="alert"></p>

        <form class="login-modal__form" action="#" method="post" data-email-link-form>
            <input class="login-modal__field" type="email" name="login-email" placeholder="Northwestern email" autocomplete="email" required />
            <button class="login-modal__submit" type="submit" data-email-link-submit>Email me a login link</button>
        </form>
    </div>
</div>

<script>
    (() => {
        const modal = document.querySelector("[data-login-modal]");

        if (!modal || modal.dataset.loginBound === "true") {
            return;
        }

        modal.dataset.loginBound = "true";
        const errorMessage = modal.querySelector("[data-login-error]");
        const emailLinkForm = modal.querySelector("[data-email-link-form]");
        const emailLinkSubmit = modal.querySelector("[data-email-link-submit]");

        const setMessage = (message, type = "error") => {
            if (errorMessage) {
                errorMessage.textContent = message;
                errorMessage.classList.remove("is-error", "is-success");

                if (message) {
                    errorMessage.classList.add(type === "success" ? "is-success" : "is-error");
                }
            }
        };

        const clearMessage = () => setMessage("");

        const setLoading = (isLoading) => {
            if (!emailLinkSubmit) {
                return;
            }

            emailLinkSubmit.disabled = isLoading;
            emailLinkSubmit.style.opacity = isLoading ? "0.7" : "";
        };

        const isNorthwesternEmail = (email) => {
            const normalizedEmail = String(email || "").toLowerCase();
            return normalizedEmail.endsWith("@u.northwestern.edu") ||
                normalizedEmail.endsWith("@northwestern.edu") ||
                normalizedEmail.endsWith("@ads.northwestern.edu");
        };

        const firebaseConfig = () => ({
            apiKey: modal.dataset.firebaseApiKey,
            authDomain: modal.dataset.firebaseAuthDomain,
            projectId: modal.dataset.firebaseProjectId,
            appId: modal.dataset.firebaseAppId
        });

        const loadFirebaseAuth = async () => {
            const [{ initializeApp, getApp, getApps }, authModule] = await Promise.all([
                import("https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js"),
                import("https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js")
            ]);

            const config = firebaseConfig();

            if (Object.values(config).some((value) => !value)) {
                throw new Error("Firebase is not configured yet.");
            }

            const app = getApps().length ? getApp() : initializeApp(config);

            return {
                auth: authModule.getAuth(app),
                ...authModule
            };
        };

        const createRailsSession = async (firebaseUser) => {
            const idToken = await firebaseUser.getIdToken();
            const response = await fetch(modal.dataset.sessionUrl, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "X-CSRF-Token": modal.dataset.csrfToken
                },
                body: JSON.stringify({ id_token: idToken })
            });

            if (!response.ok) {
                const body = await response.json().catch(() => ({}));
                throw new Error(body.error || "Could not finish login.");
            }
        };

        const openModal = () => {
            clearMessage();
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("login-modal-open");
        };

        const closeModal = () => {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("login-modal-open");
        };

        document.querySelectorAll("[data-login-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", (event) => {
                event.preventDefault();
                openModal();
            });
        });

        modal.querySelectorAll("[data-login-close]").forEach((closeButton) => {
            closeButton.addEventListener("click", closeModal);
        });

        modal.addEventListener("click", (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && modal.classList.contains("is-open")) {
                closeModal();
            }
        });

        if (emailLinkForm) {
            emailLinkForm.addEventListener("submit", async (event) => {
                event.preventDefault();
                clearMessage();
                setLoading(true);

                const formData = new FormData(emailLinkForm);
                const email = String(formData.get("login-email") || "").trim().toLowerCase();

                try {
                    if (!isNorthwesternEmail(email)) {
                        throw new Error("Use your Northwestern email to log in.");
                    }

                    const { auth, sendSignInLinkToEmail } = await loadFirebaseAuth();
                    await sendSignInLinkToEmail(auth, email, {
                        url: `${window.location.origin}${window.location.pathname}`,
                        handleCodeInApp: true
                    });
                    window.localStorage.setItem("emailForSignIn", email);
                    setMessage("Check your email for the login link.", "success");
                } catch (error) {
                    setMessage(error.message || "Could not send login link.");
                } finally {
                    setLoading(false);
                }
            });
        }

        const completeEmailLinkSignIn = async () => {
            try {
                const { auth, isSignInWithEmailLink, signInWithEmailLink } = await loadFirebaseAuth();

                if (!isSignInWithEmailLink(auth, window.location.href)) {
                    return;
                }

                let email = window.localStorage.getItem("emailForSignIn");

                if (!email) {
                    email = window.prompt("Enter the Northwestern email you used to request this login link.");
                }

                if (!email || !isNorthwesternEmail(email)) {
                    throw new Error("Use your Northwestern email to finish logging in.");
                }

                const credential = await signInWithEmailLink(auth, email, window.location.href);
                window.localStorage.removeItem("emailForSignIn");
                await createRailsSession(credential.user);
                window.location.replace(`${window.location.origin}${window.location.pathname}`);
            } catch (error) {
                openModal();
                setMessage(error.message || "Could not finish email link login.");
            }
        };

        completeEmailLinkSignIn();
    })();
</script>
