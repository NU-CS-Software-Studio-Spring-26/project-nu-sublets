<style>
    .login-modal {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .login-modal.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .login-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(17, 12, 20, 0.34);
        backdrop-filter: blur(3px);
    }

    .login-modal__dialog {
        position: relative;
        width: min(100%, 600px);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
        padding: 32px 48px;
        z-index: 1;
    }

    .login-modal__close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #5f5f5f;
        font-size: 24px;
        line-height: 1;
    }

    .login-modal__title {
        margin: 0 0 16px;
        font-family: "Rubik", sans-serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.5;
    }

    .login-modal__social {
        width: 100%;
        min-height: 52px;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        background: #ffffff;
        color: #000000;
        font-family: "Rubik", sans-serif;
        font-size: 16px;
        line-height: 2;
    }

    .login-modal__social:hover,
    .login-modal__social:focus-visible {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .login-modal__signup {
        margin: 0;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 2;
        text-align: center;
    }

    .login-modal__error {
        display: none;
        margin: 0;
        border-radius: 8px;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 10px 12px;
    }

    .login-modal__error:not(:empty) {
        display: block;
    }

    .login-modal__error.is-error {
        background: #fff3f3;
        color: #9f1d1d;
    }

    .login-modal__error.is-success {
        background: #ecfdf3;
        color: #166534;
    }

    .login-modal__oauth-note {
        margin: 0;
        border-radius: 8px;
        background: #fff8e1;
        color: #5f4300;
        font-family: "Rubik", sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 10px 12px;
    }

    .login-modal__signup-link {
        color: #4E2A84;
        text-decoration: underline;
    }

    .login-modal__social {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 8px 16px;
        text-align: left;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .login-modal__icon {
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .login-modal__trigger {
        border: 1px solid #d9d9d9;
        border-radius: 999px;
        padding: 8px 16px;
        font-family: "Rubik", sans-serif;
        line-height: 1.2;
    }

    body.login-modal-open {
        overflow: hidden;
    }

    @media (max-width: 767.98px) {
        .login-modal {
            padding: 16px;
        }

        .login-modal__dialog {
            padding: 28px 20px 24px;
        }
    }
</style>

<div
    id="login-modal"
    class="login-modal"
    data-login-modal
    aria-hidden="true"
>
    <div class="login-modal__backdrop" data-login-close></div>
    <div class="login-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="login-modal-title">
        <button class="login-modal__close" type="button" aria-label="Close login popup" data-login-close>&times;</button>
        <h2 class="login-modal__title" id="login-modal-title">Login</h2>

        <%= button_to "Sign in with Google",
                      google_oauth_configured? ? "/auth/google_oauth2" : google_oauth_path,
                      method: :post,
                      class: "login-modal__social",
                      data: { turbo: false } %>

        <p class="login-modal__signup">
            Need an account?
            <%= link_to "Sign up", signup_path, class: "login-modal__signup-link" %>
        </p>
    </div>
</div>

<script>
    (() => {
        const namespace = window.NuSublets || (window.NuSublets = {});

        if (namespace.loginModalReady) {
            namespace.initializeLoginModal?.();
            return;
        }

        namespace.loginModalReady = true;
        const boundTriggers = new WeakSet();
        const boundCloseButtons = new WeakSet();
        const boundModals = new WeakSet();

        const openModal = (modal) => {
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("login-modal-open");
        };

        const closeModal = (modal) => {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("login-modal-open");
        };

        const initializeLoginModal = () => {
            const modal = document.querySelector("[data-login-modal]");

            if (!modal) {
                return;
            }

            document.querySelectorAll("[data-login-trigger]").forEach((trigger) => {
                if (boundTriggers.has(trigger)) return;

                boundTriggers.add(trigger);
                trigger.addEventListener("click", (event) => {
                    event.preventDefault();
                    openModal(modal);
                });
            });

            modal.querySelectorAll("[data-login-close]").forEach((closeButton) => {
                if (boundCloseButtons.has(closeButton)) return;

                boundCloseButtons.add(closeButton);
                closeButton.addEventListener("click", () => closeModal(modal));
            });

            if (!boundModals.has(modal)) {
                boundModals.add(modal);
                modal.addEventListener("click", (event) => {
                    if (event.target === modal) {
                        closeModal(modal);
                    }
                });
            }
        };

        document.addEventListener("keydown", (event) => {
            const modal = document.querySelector("[data-login-modal]");

            if (event.key === "Escape" && modal?.classList.contains("is-open")) {
                closeModal(modal);
            }
        });

        document.addEventListener("turbo:load", initializeLoginModal);
        document.addEventListener("turbo:before-cache", () => {
            const modal = document.querySelector("[data-login-modal]");

            if (modal) {
                closeModal(modal);
            }
        });

        namespace.initializeLoginModal = initializeLoginModal;
        initializeLoginModal();
    })();
</script>
