<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Profile | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-muted: #5b5b5b;
                --nu-accent: #4E2A84;
                --nu-shadow-soft: 0 0 25px rgba(217, 217, 217, 0.5);
                --nu-card-shadow: 3.682px 3.682px 3.682px rgba(166, 166, 166, 0.25);
                --nu-verified: #3B82F6;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Fustat", sans-serif;
            }

            a {
                color: inherit;
            }

            img {
                display: block;
                max-width: 100%;
            }

            .page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid var(--nu-border);
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: var(--nu-text);
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .brand {
                font-weight: 400;
            }

            .profile-page {
                padding: 32px 48px 64px;
            }

            .profile-shell {
                max-width: 1180px;
                margin: 0 auto;
            }

            .profile-grid {
                display: grid;
                grid-template-columns: minmax(300px, 400px) minmax(300px, 360px);
                justify-content: start;
                gap: 48px;
                align-items: start;
            }

            .profile-card {
                background: #fff;
                border-radius: 16px;
                box-shadow: var(--nu-shadow-soft);
                padding: 24px 26px;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 12px;
            }

            .profile-avatar {
                width: 124px;
                height: 124px;
                border-radius: 50%;
                object-fit: cover;
            }

            .verified-row,
            .rating-row {
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .verified-icon {
                width: 32px;
                height: 32px;
                flex: 0 0 auto;
            }

            .verified-copy {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 17px;
                line-height: 1.7;
                color: var(--nu-verified);
            }

            .star-row {
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .star-icon {
                width: 20px;
                height: 20px;
                display: block;
            }

            .rating-copy {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 17px;
                line-height: 1.7;
            }

            .bio-copy {
                width: 100%;
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 17px;
                line-height: 1.7;
            }

            .profile-meta,
            .profile-stats {
                width: 100%;
                display: grid;
                gap: 10px;
            }

            .profile-meta {
                margin-top: 8px;
            }

            .profile-meta-item,
            .profile-stat {
                border: 1px solid var(--nu-border);
                border-radius: 12px;
                padding: 12px 14px;
            }

            .profile-meta-label,
            .profile-stat-label {
                margin: 0 0 4px;
                font-family: "Rubik", sans-serif;
                font-size: 12px;
                font-weight: 600;
                line-height: 1.2;
                color: var(--nu-muted);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .profile-meta-value,
            .profile-stat-value {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                line-height: 1.4;
            }

            .profile-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                margin-top: 6px;
            }

            .profile-content {
                display: flex;
                flex-direction: column;
                gap: 10px;
                width: 100%;
                max-width: 360px;
            }

            .profile-name {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: clamp(1.95rem, 3vw, 2.2rem);
                font-weight: 700;
                line-height: 1.2;
            }

            .section-title {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 21px;
                font-weight: 500;
                line-height: 1.6;
            }

            .section-subtitle {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.5;
                color: var(--nu-muted);
            }

            .listing-card {
                display: block;
                background: #fff;
                border-radius: 7px;
                overflow: hidden;
                box-shadow: var(--nu-card-shadow);
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .listing-card:hover,
            .listing-card:focus-visible {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .listing-card:focus-visible {
                outline: 3px solid rgba(156, 81, 182, 0.45);
                outline-offset: 4px;
            }

            .listing-media {
                position: relative;
                height: 190px;
                overflow: visible;
            }

            .favorite-button {
                position: absolute;
                top: 16px;
                right: 16px;
                z-index: 2;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 24px;
                height: 24px;
                border: 0;
                padding: 0;
                background: transparent;
                cursor: pointer;
                filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
            }

            .favorite-button svg {
                width: 24px;
                height: 24px;
                display: block;
                pointer-events: none;
            }

            .favorite-button path {
                fill: transparent;
                stroke: #fff;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: fill 0.16s ease, stroke 0.16s ease, transform 0.16s ease;
            }

            .favorite-button.is-favorite path {
                fill: #ed4956;
                stroke: #ed4956;
            }

            .favorite-button:hover path,
            .favorite-button:focus-visible path {
                transform: scale(1.04);
                transform-origin: center;
            }

            .favorite-button:focus-visible {
                outline: 3px solid rgba(156, 81, 182, 0.5);
                outline-offset: 4px;
                border-radius: 999px;
            }

            .listing-main-image {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

            .listing-avatar {
                position: absolute;
                left: 12px;
                bottom: -8px;
                width: 50px;
                height: 50px;
                border: 2px solid #fff;
                border-radius: 50%;
                object-fit: cover;
            }

            .listing-body {
                padding: 6px 8px 10px;
            }

            .listing-price {
                margin: 0 0 3px;
                font-family: "Rubik", sans-serif;
                font-size: 21px;
                font-weight: 800;
                line-height: 1.05;
            }

            .listing-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 3px;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                font-weight: 500;
                line-height: 1.2;
            }

            .listing-address {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 10px;
                line-height: 1.2;
            }

            .empty-state {
                border: 1px dashed var(--nu-border);
                border-radius: 16px;
                padding: 22px 20px;
                background: #fff;
            }

            .empty-state-copy {
                margin: 0 0 16px;
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                line-height: 1.6;
                color: var(--nu-muted);
            }

            .empty-state-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 44px;
                border-radius: 12px;
                padding: 0 18px;
                background: var(--nu-accent);
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 15px;
                font-weight: 600;
                text-decoration: none;
            }

            @media (max-width: 991.98px) {
                .profile-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 24px;
                    max-width: 480px;
                }

                .profile-content {
                    gap: 12px;
                }
            }

            @media (max-width: 767.98px) {
                .topbar {
                    padding-inline: 16px;
                }

                .topbar-nav {
                    gap: 20px;
                }

                .brand,
                .nav-link {
                    font-size: 14px;
                }

                .profile-page {
                    padding: 24px 24px 40px;
                }

                .profile-card {
                    padding: 20px 18px;
                }

                .profile-avatar {
                    width: 112px;
                    height: 112px;
                }

                .verified-copy,
                .rating-copy,
                .bio-copy {
                    font-size: 15px;
                }

                .profile-meta-value,
                .profile-stat-value,
                .section-subtitle,
                .empty-state-copy {
                    font-size: 14px;
                }

                .section-title {
                    font-size: 19px;
                }

                .listing-media {
                    height: 216px;
                }

                .listing-main-image {
                    height: 204px;
                }

                .listing-avatar {
                    width: 50px;
                    height: 50px;
                }

                .listing-price {
                    font-size: 22px;
                }

                .listing-meta,
                .listing-address {
                    font-size: 10px;
                }
            }
        </style>
    </head>
    <body>
        <% user = current_user %>
        <% listings = user.sublet_listings.order(created_at: :desc) %>
        <% first_name = user.first_name.presence || user.display_name.split.first %>
        <% initials = user.display_name.split.map { |part| part.first }.join.first(2).upcase.presence || "NU" %>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand d-flex align-items-center" href="<%= root_path %>" style="text-decoration: none; color: #4E2A84; font-weight: bold; font-size: 1.25rem;">
                        <div style="background: #4E2A84; width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-right: 8px;">
                            <svg width="24" height="24" viewBox="0 0 32 24" fill="none">
                                <!-- House -->
                                <path d="M2 12L8 7L14 12V18C14 18.6 13.6 19 13 19H3C2.4 19 2 18.6 2 18V12Z" fill="white"/>
                                <path d="M6 15H10V19H6V15Z" fill="#4E2A84"/>
                                <!-- Wildcat head -->
                                <ellipse cx="24" cy="12" rx="6" ry="5" fill="white"/>
                                <!-- Cat ears -->
                                <path d="M20 8L21 6L22 8" fill="white" stroke="white" stroke-width="0.5"/>
                                <path d="M26 8L27 6L28 8" fill="white" stroke="white" stroke-width="0.5"/>
                                <!-- Cat eyes -->
                                <ellipse cx="21.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                                <ellipse cx="26.5" cy="11" rx="1" ry="1.2" fill="#4E2A84"/>
                                <!-- Cat nose and mouth -->
                                <path d="M24 13.5L23.3 14.2L24.7 14.2Z" fill="#4E2A84"/>
                                <!-- Whiskers -->
                                <line x1="18" y1="11.5" x2="20" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="28" y1="11.5" x2="30" y2="11.5" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="18.5" y1="13" x2="20" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                                <line x1="28" y1="13" x2="29.5" y2="13" stroke="#4E2A84" stroke-width="0.8"/>
                            </svg>
                        </div>
                        NU Sublets
                    </a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>">Browse</a>
                        <a class="nav-link p-0" href="<%= search_results_path %>">Search</a>
                        <a class="nav-link p-0" href="<%= saved_path %>">Saved</a>
                        <a class="nav-link p-0" href="<%= post_sublet_path %>">Post Sublet</a>
                        <%= render "auth_nav" %>
                    </nav>
                </div>
            </header>

            <main class="profile-page">
                <div class="profile-shell">
                    <div class="profile-grid">
                        <section class="profile-card" aria-label="Profile summary">
                            <img class="profile-avatar" src="https://ui-avatars.com/api/?name=<%= ERB::Util.url_encode(initials) %>&background=F4EFF8&color=3E1B4B&size=248&bold=true" alt="<%= user.display_name %> profile avatar" />

                            <div class="verified-row">
                                <svg class="verified-icon" viewBox="0 0 32 32" aria-hidden="true">
                                    <path d="M16 2 6 5.68v8.77C6 21.64 10.26 28.35 16 30.43c5.74-2.08 10-8.79 10-15.98V5.68L16 2Z" fill="none" stroke="#3B82F6" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                                    <path d="m11 16.25 3.68 3.68L21 13.61" fill="none" stroke="#3B82F6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" />
                                </svg>
                                <p class="verified-copy">Verified Student</p>
                            </div>

                            <p class="bio-copy">
                                Hi <%= first_name %>, this is your NU Sublets profile. You&rsquo;re signed in with your Northwestern account and can manage your listings, contact details, and posting activity from here.
                            </p>

                            <div class="profile-meta" aria-label="Profile details">
                                <div class="profile-meta-item">
                                    <p class="profile-meta-label">Northwestern Email</p>
                                    <p class="profile-meta-value"><%= user.email %></p>
                                </div>
                                <div class="profile-meta-item">
                                    <p class="profile-meta-label">Display Name</p>
                                    <p class="profile-meta-value"><%= user.display_name %></p>
                                </div>
                            </div>

                            <div class="profile-stats" aria-label="Profile stats">
                                <div class="profile-stat">
                                    <p class="profile-stat-label">Listings</p>
                                    <p class="profile-stat-value"><%= listings.count %></p>
                                </div>
                                <div class="profile-stat">
                                    <p class="profile-stat-label">Status</p>
                                    <p class="profile-stat-value"><%= user.active? ? "Active" : "Inactive" %></p>
                                </div>
                            </div>
                        </section>

                        <section class="profile-content" aria-label="Profile listings">
                            <h1 class="profile-name"><%= user.display_name %></h1>
                            <h2 class="section-title">Current Listings</h2>
                            <p class="section-subtitle"><%= listings.any? ? "Your live sublet posts appear here." : "You have not posted a sublet yet." %></p>

                            <% if listings.any? %>
                                <% listings.each do |listing| %>
                                    <a class="listing-card" href="<%= listing_path %>">
                                        <div class="listing-media">
                                            <img class="listing-main-image" src="<%= apartment_listing_image_path(listing) %>" alt="<%= listing.title.presence || 'Sublet listing' %>" />
                                            <img class="listing-avatar" src="https://ui-avatars.com/api/?name=<%= ERB::Util.url_encode(initials) %>&background=F4EFF8&color=3E1B4B&size=100&bold=true" alt="<%= user.display_name %> listing avatar" />
                                            <span class="favorite-button" role="button" tabindex="0" aria-pressed="false" aria-label="Save to favorite listings">
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    <path fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"></path>
                                                </svg>
                                            </span>
                                        </div>
                                        <div class="listing-body">
                                            <p class="listing-price"><%= number_to_currency(listing.price, precision: 0) %>/month</p>
                                            <div class="listing-meta">
                                                <span><%= pluralize(listing.bedrooms || 0, "bedroom") %></span>
                                                <span><%= pluralize(listing.bathrooms || 0, "bathroom") %></span>
                                                <span><%= listing.furnished? ? "Furnished" : "Unfurnished" %></span>
                                            </div>
                                            <p class="listing-address"><%= listing.address.presence || "Address coming soon" %></p>
                                        </div>
                                    </a>
                                <% end %>
                            <% else %>
                                <div class="empty-state">
                                    <p class="empty-state-copy">Create your first listing to start receiving interest from other Northwestern students.</p>
                                    <a class="empty-state-link" href="<%= post_sublet_path %>">Post a Sublet</a>
                                </div>
                            <% end %>
                        </section>
                    </div>
                </div>
            </main>
            <%= render "shared/footer" %>
        </div>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        ></script>
        <%= render "login_modal" %>
        <script>
            (() => {
                const storageKey = "nuSublets.favoriteListings";

                const readFavorites = () => {
                    try {
                        return JSON.parse(localStorage.getItem(storageKey)) || [];
                    } catch (_error) {
                        return [];
                    }
                };

                const writeFavorites = (favorites) => {
                    localStorage.setItem(storageKey, JSON.stringify(favorites));
                };

                const getCardId = (card) => {
                    const address = card.querySelector(".listing-address")?.textContent.trim() || "";
                    const price = card.querySelector(".listing-price")?.textContent.trim() || "";
                    const image = card.querySelector(".listing-main-image")?.getAttribute("src") || "";
                    return [address, price, image].join("|").toLowerCase();
                };

                const getCardData = (card) => ({
                    id: getCardId(card),
                    href: card.getAttribute("href") || "#",
                    imageSrc: card.querySelector(".listing-main-image")?.getAttribute("src") || "",
                    imageAlt: card.querySelector(".listing-main-image")?.getAttribute("alt") || "Favorite listing",
                    avatarSrc: card.querySelector(".listing-avatar")?.getAttribute("src") || "",
                    avatarAlt: card.querySelector(".listing-avatar")?.getAttribute("alt") || "Listing host",
                    price: card.querySelector(".listing-price")?.textContent.trim() || "",
                    meta: Array.from(card.querySelectorAll(".listing-meta span")).map((item) => item.textContent.trim()),
                    address: card.querySelector(".listing-address")?.textContent.trim() || ""
                });

                document.querySelectorAll(".listing-card").forEach((card) => {
                    const button = card.querySelector(".favorite-button");
                    if (!button) {
                        return;
                    }

                    const setButtonState = (favored) => {
                        button.classList.toggle("is-favorite", favored);
                        button.setAttribute("aria-pressed", favored ? "true" : "false");
                        button.setAttribute("aria-label", favored ? "Remove from favorite listings" : "Save to favorite listings");
                    };

                    const id = getCardId(card);
                    setButtonState(readFavorites().some((listing) => listing.id === id));

                    const activate = (event) => {
                        event.preventDefault();
                        event.stopPropagation();

                        const listing = getCardData(card);
                        const favorites = readFavorites();
                        const alreadySaved = favorites.some((item) => item.id === listing.id);
                        const nextFavorites = alreadySaved
                            ? favorites.filter((item) => item.id !== listing.id)
                            : [listing, ...favorites];

                        writeFavorites(nextFavorites);
                        setButtonState(!alreadySaved);
                    };

                    button.addEventListener("click", activate);
                    button.addEventListener("keydown", (event) => {
                        if (event.key === "Enter" || event.key === " ") {
                            activate(event);
                        }
                    });
                });
            })();
        </script>
    </body>
</html>
