        <script>
            (() => {
                const monthFormatter = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" });
                const weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
                let activePicker = null;

                const toDateKey = (date) => [
                    date.getFullYear(),
                    String(date.getMonth() + 1).padStart(2, "0"),
                    String(date.getDate()).padStart(2, "0")
                ].join("-");

                const formatDate = (date) => [
                    String(date.getMonth() + 1).padStart(2, "0"),
                    String(date.getDate()).padStart(2, "0"),
                    date.getFullYear()
                ].join("/");

                const parseDate = (value) => {
                    const match = value.trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);

                    if (!match) {
                        return null;
                    }

                    const month = Number.parseInt(match[1], 10) - 1;
                    const day = Number.parseInt(match[2], 10);
                    const year = Number.parseInt(match[3], 10);
                    const date = new Date(year, month, day);

                    if (date.getFullYear() !== year || date.getMonth() !== month || date.getDate() !== day) {
                        return null;
                    }

                    return date;
                };

                const closePicker = (picker) => {
                    if (!picker) {
                        return;
                    }

                    picker.popover.hidden = true;
                    picker.toggle.setAttribute("aria-expanded", "false");

                    if (activePicker === picker) {
                        activePicker = null;
                    }
                };

                const closeActivePicker = () => closePicker(activePicker);

                const selectDate = (picker, date) => {
                    picker.input.value = formatDate(date);
                    picker.input.dispatchEvent(new Event("change", { bubbles: true }));
                    closePicker(picker);
                    picker.input.focus();
                };

                const focusDateButton = (picker, date) => {
                    const dateKey = toDateKey(date);
                    picker.visibleMonth = date.getMonth();
                    picker.visibleYear = date.getFullYear();
                    renderPicker(picker, dateKey);
                };

                const getKeyboardDate = (picker) => {
                    const activeButton = picker.popover.querySelector(".date-picker-day:focus");

                    if (activeButton?.dataset.date) {
                        return parseDate(activeButton.dataset.date);
                    }

                    return parseDate(picker.input.value) || new Date();
                };

                const renderPicker = (picker, focusDateKey = null) => {
                    const selectedDate = parseDate(picker.input.value);
                    const selectedKey = selectedDate ? toDateKey(selectedDate) : null;
                    const todayKey = toDateKey(new Date());
                    const monthStart = new Date(picker.visibleYear, picker.visibleMonth, 1);
                    const gridStart = new Date(picker.visibleYear, picker.visibleMonth, 1 - monthStart.getDay());

                    picker.popover.innerHTML = "";

                    const header = document.createElement("div");
                    header.className = "date-picker-header";

                    const previousButton = document.createElement("button");
                    previousButton.className = "date-picker-nav";
                    previousButton.type = "button";
                    previousButton.setAttribute("aria-label", "Previous month");
                    previousButton.textContent = "\u2039";

                    const title = document.createElement("div");
                    title.className = "date-picker-title";
                    title.setAttribute("aria-live", "polite");
                    title.textContent = monthFormatter.format(monthStart);

                    const nextButton = document.createElement("button");
                    nextButton.className = "date-picker-nav";
                    nextButton.type = "button";
                    nextButton.setAttribute("aria-label", "Next month");
                    nextButton.textContent = "\u203a";

                    header.append(previousButton, title, nextButton);

                    const weekdays = document.createElement("div");
                    weekdays.className = "date-picker-weekdays";
                    weekdayLabels.forEach((weekday) => {
                        const label = document.createElement("span");
                        label.textContent = weekday;
                        weekdays.append(label);
                    });

                    const grid = document.createElement("div");
                    grid.className = "date-picker-grid";
                    grid.setAttribute("aria-label", monthFormatter.format(monthStart));

                    for (let index = 0; index < 42; index += 1) {
                        const date = new Date(gridStart);
                        date.setDate(gridStart.getDate() + index);

                        const dateKey = toDateKey(date);
                        const dayButton = document.createElement("button");
                        dayButton.className = "date-picker-day";
                        dayButton.type = "button";
                        dayButton.textContent = date.getDate();
                        dayButton.dataset.date = formatDate(date);
                        dayButton.setAttribute("aria-label", new Intl.DateTimeFormat("en-US", { dateStyle: "full" }).format(date));
                        dayButton.setAttribute("aria-pressed", dateKey === selectedKey ? "true" : "false");

                        if (date.getMonth() !== picker.visibleMonth) {
                            dayButton.classList.add("is-muted");
                        }

                        if (dateKey === todayKey) {
                            dayButton.classList.add("is-today");
                        }

                        if (dateKey === selectedKey) {
                            dayButton.classList.add("is-selected");
                        }

                        dayButton.addEventListener("click", (event) => {
                            event.preventDefault();
                            event.stopPropagation();
                            selectDate(picker, date);
                        });

                        dayButton.addEventListener("keydown", (event) => {
                            const focusedDate = getKeyboardDate(picker);
                            let nextDate = null;

                            if (event.key === "ArrowLeft") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() - 1);
                            } else if (event.key === "ArrowRight") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() + 1);
                            } else if (event.key === "ArrowUp") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() - 7);
                            } else if (event.key === "ArrowDown") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() + 7);
                            } else if (event.key === "Home") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() - focusedDate.getDay());
                            } else if (event.key === "End") {
                                nextDate = new Date(focusedDate);
                                nextDate.setDate(focusedDate.getDate() + (6 - focusedDate.getDay()));
                            } else if (event.key === "PageUp" || event.key === "PageDown") {
                                nextDate = new Date(focusedDate);
                                const monthOffset = event.key === "PageUp" ? -1 : 1;
                                nextDate.setMonth(focusedDate.getMonth() + (event.shiftKey ? monthOffset * 12 : monthOffset));
                            } else if (event.key === "Escape") {
                                event.preventDefault();
                                closePicker(picker);
                                picker.input.focus();
                                return;
                            }

                            if (nextDate) {
                                event.preventDefault();
                                event.stopPropagation();
                                focusDateButton(picker, nextDate);
                            }
                        });

                        grid.append(dayButton);
                    }

                    previousButton.addEventListener("click", (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        picker.visibleMonth -= 1;

                        if (picker.visibleMonth < 0) {
                            picker.visibleMonth = 11;
                            picker.visibleYear -= 1;
                        }

                        renderPicker(picker);
                        picker.popover.querySelector(".date-picker-nav")?.focus();
                    });

                    nextButton.addEventListener("click", (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        picker.visibleMonth += 1;

                        if (picker.visibleMonth > 11) {
                            picker.visibleMonth = 0;
                            picker.visibleYear += 1;
                        }

                        renderPicker(picker);
                        picker.popover.querySelectorAll(".date-picker-nav")[1]?.focus();
                    });

                    picker.popover.append(header, weekdays, grid);

                    if (focusDateKey) {
                        picker.popover.querySelector(`[data-date="${focusDateKey}"]`)?.focus();
                    }
                };

                const openPicker = (picker) => {
                    const selectedDate = parseDate(picker.input.value) || new Date();

                    if (activePicker && activePicker !== picker) {
                        closePicker(activePicker);
                    }

                    picker.visibleMonth = selectedDate.getMonth();
                    picker.visibleYear = selectedDate.getFullYear();
                    renderPicker(picker);
                    picker.popover.hidden = false;
                    picker.toggle.setAttribute("aria-expanded", "true");
                    activePicker = picker;
                };

                document.querySelectorAll("[data-date-picker]").forEach((container) => {
                    const input = container.querySelector("[data-date-input]");
                    const toggle = container.querySelector("[data-date-toggle]");
                    const popover = container.querySelector("[data-date-popover]");

                    if (!input || !toggle || !popover) {
                        return;
                    }

                    const picker = {
                        container,
                        input,
                        toggle,
                        popover,
                        visibleMonth: new Date().getMonth(),
                        visibleYear: new Date().getFullYear()
                    };

                    toggle.addEventListener("click", (event) => {
                        event.preventDefault();
                        event.stopPropagation();

                        if (popover.hidden) {
                            openPicker(picker);
                        } else {
                            closePicker(picker);
                        }
                    });

                    input.addEventListener("focus", () => openPicker(picker));
                    input.addEventListener("click", () => openPicker(picker));
                    input.addEventListener("keydown", (event) => {
                        if (event.key === "ArrowDown") {
                            event.preventDefault();
                            openPicker(picker);
                            focusDateButton(picker, parseDate(input.value) || new Date());
                        } else if (event.key === "Escape") {
                            closePicker(picker);
                        }
                    });
                    toggle.addEventListener("keydown", (event) => {
                        if (event.key === "ArrowDown") {
                            event.preventDefault();
                            openPicker(picker);
                            focusDateButton(picker, parseDate(input.value) || new Date());
                        }
                    });
                    popover.addEventListener("click", (event) => event.stopPropagation());
                });

                document.addEventListener("click", (event) => {
                    if (activePicker && !activePicker.container.contains(event.target)) {
                        closeActivePicker();
                    }
                });

                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape") {
                        closeActivePicker();
                    }
                });
            })();

            document.querySelectorAll("[data-carousel-track]").forEach((track) => {
                const prevButton = document.querySelector(`[data-carousel-prev="${track.id}"]`);
                const nextButton = document.querySelector(`[data-carousel-next="${track.id}"]`);

                if (!prevButton || !nextButton) {
                    return;
                }

                const getScrollAmount = () => {
                    const firstCard = track.querySelector(".listing-card");

                    if (!firstCard) {
                        return 0;
                    }

                    const styles = window.getComputedStyle(track);
                    const gap = Number.parseFloat(styles.columnGap || styles.gap || "0");
                    return firstCard.getBoundingClientRect().width + gap;
                };

                const updateButtons = () => {
                    const maxScrollLeft = track.scrollWidth - track.clientWidth - 2;
                    prevButton.disabled = track.scrollLeft <= 2;
                    nextButton.disabled = track.scrollLeft >= maxScrollLeft;
                };

                const scrollByCard = (direction) => {
                    track.scrollBy({ left: getScrollAmount() * direction, behavior: "smooth" });
                };

                prevButton.addEventListener("click", () => {
                    scrollByCard(-1);
                });

                nextButton.addEventListener("click", () => {
                    scrollByCard(1);
                });

                track.addEventListener("keydown", (event) => {
                    if (event.key === "ArrowLeft") {
                        event.preventDefault();
                        scrollByCard(-1);
                    } else if (event.key === "ArrowRight") {
                        event.preventDefault();
                        scrollByCard(1);
                    } else if (event.key === "Home") {
                        event.preventDefault();
                        track.scrollTo({ left: 0, behavior: "smooth" });
                    } else if (event.key === "End") {
                        event.preventDefault();
                        track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
                    }
                });

                track.addEventListener("scroll", updateButtons, { passive: true });
                window.addEventListener("resize", updateButtons);
                updateButtons();
            });
        </script>
    <%= render "shared/service_worker_registration" %>

