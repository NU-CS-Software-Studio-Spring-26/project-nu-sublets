<style>
    .favorite-button {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border: 0;
        padding: 0;
        background: transparent;
        cursor: pointer;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
    }

    .favorite-button svg {
        width: 24px;
        height: 24px;
        display: block;
        pointer-events: none;
    }

    .favorite-button path {
        fill: transparent;
        stroke: #fff;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: fill 0.16s ease, stroke 0.16s ease, transform 0.16s ease;
    }

    .favorite-button.is-favorite path {
        fill: #ed4956;
        stroke: #ed4956;
    }

    .favorite-button:hover path,
    .favorite-button:focus-visible path {
        transform: scale(1.04);
        transform-origin: center;
    }

    .favorite-button:focus-visible {
        outline: 3px solid rgba(156, 81, 182, 0.5);
        outline-offset: 4px;
        border-radius: 999px;
    }

    .favorite-listing-carousel {
        position: relative;
        width: 100%;
    }

    .favorite-listing-track {
        display: flex;
        gap: 22px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 4px 2px 12px;
    }

    .favorite-listing-track::-webkit-scrollbar {
        display: none;
    }

    .favorite-listing-track .listing-card {
        flex: 0 0 min(360px, calc(100vw - 56px));
        scroll-snap-align: start;
    }

    .favorite-carousel-button {
        position: absolute;
        top: 50%;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
        color: #000;
        font-family: "Rubik", sans-serif;
        font-size: 24px;
        line-height: 1;
        transform: translateY(-50%);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .favorite-carousel-button:hover,
    .favorite-carousel-button:focus-visible {
        transform: translateY(-50%) scale(1.04);
    }

    .favorite-carousel-button:disabled {
        opacity: 0.4;
        cursor: default;
    }

    .favorite-carousel-button.prev {
        left: -18px;
    }

    .favorite-carousel-button.next {
        right: -18px;
    }

    @media (max-width: 767.98px) {
        .favorite-carousel-button {
            display: none;
        }
    }
</style>

<script>
    (() => {
        const storageKey = "nuSublets.favoriteListings";
        const heartSvg = `
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"></path>
            </svg>
        `;

        const escapeHtml = (value) => String(value || "").replace(/[&<>"']/g, (character) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[character]);

        const readFavorites = () => {
            try {
                return JSON.parse(localStorage.getItem(storageKey)) || [];
            } catch (_error) {
                return [];
            }
        };

        const writeFavorites = (favorites) => {
            localStorage.setItem(storageKey, JSON.stringify(favorites));
        };

        const getCardId = (card) => {
            const address = card.querySelector(".listing-address")?.textContent.trim() || "";
            const price = card.querySelector(".listing-price")?.textContent.trim() || "";
            const image = card.querySelector(".listing-main-image")?.getAttribute("src") || "";
            return [address, price, image].join("|").toLowerCase();
        };

        const getCardData = (card) => ({
            id: getCardId(card),
            href: card.getAttribute("href") || card.querySelector("a[href*='/listings/']")?.getAttribute("href") || "#",
            imageSrc: card.querySelector(".listing-main-image")?.getAttribute("src") || "",
            imageAlt: card.querySelector(".listing-main-image")?.getAttribute("alt") || "Favorite listing",
            avatarSrc: card.querySelector(".listing-avatar")?.getAttribute("src") || "",
            avatarAlt: card.querySelector(".listing-avatar")?.getAttribute("alt") || "Listing host",
            price: card.querySelector(".listing-price")?.textContent.trim() || "",
            title: card.querySelector(".listing-card-title")?.textContent.trim() || "",
            meta: Array.from(card.querySelectorAll(".listing-meta span")).map((item) => item.textContent.trim()),
            address: card.querySelector(".listing-address")?.textContent.trim() || ""
        });

        const updateButton = (button, favored) => {
            button.classList.toggle("is-favorite", favored);
            button.setAttribute("aria-pressed", favored ? "true" : "false");
            button.setAttribute("aria-label", favored ? "Remove from favorite listings" : "Save to favorite listings");
        };

        const getScrollAmount = (track) => {
            const firstCard = track.querySelector(".listing-card");

            if (!firstCard) {
                return 0;
            }

            const styles = window.getComputedStyle(track);
            const gap = Number.parseFloat(styles.columnGap || styles.gap || "0");
            return firstCard.getBoundingClientRect().width + gap;
        };

        const updateFavoriteCarousel = (track) => {
            const carousel = track.closest("[data-favorite-carousel]");
            const prevButton = carousel?.querySelector("[data-favorite-carousel-prev]");
            const nextButton = carousel?.querySelector("[data-favorite-carousel-next]");

            if (!prevButton || !nextButton) {
                return;
            }

            const maxScrollLeft = track.scrollWidth - track.clientWidth - 2;
            prevButton.disabled = track.scrollLeft <= 2;
            nextButton.disabled = track.scrollLeft >= maxScrollLeft;
            carousel.hidden = track.children.length === 0;
        };

        const renderFavoriteCards = () => {
            const targets = document.querySelectorAll("[data-favorite-listings]");

            if (targets.length === 0) {
                return;
            }

            const favorites = readFavorites();

            targets.forEach((target) => {
                target.innerHTML = "";

                favorites.forEach((listing) => {
                    const card = document.createElement("a");
                    card.className = "listing-card";
                    card.href = listing.href || "#";
                    card.innerHTML = `
                        <div class="listing-media">
                            <img class="listing-main-image" src="${escapeHtml(listing.imageSrc)}" alt="${escapeHtml(listing.imageAlt)}" />
                            ${listing.avatarSrc ? `<img class="listing-avatar" src="${escapeHtml(listing.avatarSrc)}" alt="${escapeHtml(listing.avatarAlt)}" />` : ""}
                        </div>
                        <div class="listing-body">
                            <p class="listing-price">${escapeHtml(listing.price)}</p>
                            ${listing.title ? `<p class="listing-card-title">${escapeHtml(listing.title)}</p>` : ""}
                            <div class="listing-meta">
                                ${(listing.meta || []).map((item) => `<span>${escapeHtml(item)}</span>`).join("")}
                            </div>
                            <p class="listing-address">${escapeHtml(listing.address)}</p>
                        </div>
                    `;
                    target.appendChild(card);
                });

                updateFavoriteCarousel(target);
            });

            document.querySelectorAll("[data-favorites-empty]").forEach((emptyState) => {
                emptyState.hidden = favorites.length > 0;
            });

            bindFavoriteButtons();
        };

        const isFavorite = (id) => readFavorites().some((listing) => listing.id === id);

        const toggleFavorite = (card, button) => {
            const listing = getCardData(card);
            const favorites = readFavorites();
            const existingIndex = favorites.findIndex((item) => item.id === listing.id);
            const nextFavorites = existingIndex >= 0
                ? favorites.filter((item) => item.id !== listing.id)
                : [listing, ...favorites];

            writeFavorites(nextFavorites);
            updateButton(button, existingIndex < 0);

            document.querySelectorAll(".listing-card").forEach((otherCard) => {
                if (getCardId(otherCard) === listing.id) {
                    const otherButton = otherCard.querySelector(".favorite-button");
                    if (otherButton) {
                        updateButton(otherButton, existingIndex < 0);
                    }
                }
            });

            renderFavoriteCards();
        };

        function bindFavoriteButtons() {
            document.querySelectorAll(".listing-card").forEach((card) => {
                const media = card.querySelector(".listing-media");
                if (!media) {
                    return;
                }

                let button = media.querySelector(".favorite-button");
                if (!button) {
                    button = document.createElement("span");
                    button.className = "favorite-button";
                    button.setAttribute("role", "button");
                    button.setAttribute("tabindex", "0");
                    button.innerHTML = heartSvg;
                    media.appendChild(button);
                }

                updateButton(button, isFavorite(getCardId(card)));

                if (button.dataset.favoriteBound === "true") {
                    return;
                }

                button.dataset.favoriteBound = "true";

                const activate = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    toggleFavorite(card, button);
                };

                button.addEventListener("click", activate);
                button.addEventListener("keydown", (event) => {
                    if (event.key === "Enter" || event.key === " ") {
                        activate(event);
                    }
                });
            });
        }

        const bindFavoriteCarousels = () => {
            document.querySelectorAll("[data-favorite-listings]").forEach((track) => {
                if (track.dataset.favoriteCarouselBound === "true") {
                    updateFavoriteCarousel(track);
                    return;
                }

                const carousel = track.closest("[data-favorite-carousel]");
                const prevButton = carousel?.querySelector("[data-favorite-carousel-prev]");
                const nextButton = carousel?.querySelector("[data-favorite-carousel-next]");

                if (!prevButton || !nextButton) {
                    return;
                }

                track.dataset.favoriteCarouselBound = "true";

                const scrollByCard = (direction) => {
                    track.scrollBy({ left: getScrollAmount(track) * direction, behavior: "smooth" });
                };

                prevButton.addEventListener("click", () => scrollByCard(-1));
                nextButton.addEventListener("click", () => scrollByCard(1));
                track.addEventListener("scroll", () => updateFavoriteCarousel(track), { passive: true });
                window.addEventListener("resize", () => updateFavoriteCarousel(track));

                track.addEventListener("keydown", (event) => {
                    if (event.key === "ArrowLeft") {
                        event.preventDefault();
                        scrollByCard(-1);
                    } else if (event.key === "ArrowRight") {
                        event.preventDefault();
                        scrollByCard(1);
                    } else if (event.key === "Home") {
                        event.preventDefault();
                        track.scrollTo({ left: 0, behavior: "smooth" });
                    } else if (event.key === "End") {
                        event.preventDefault();
                        track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
                    }
                });

                updateFavoriteCarousel(track);
            });
        };

        const initializeFavorites = () => {
            bindFavoriteCarousels();
            bindFavoriteButtons();
            renderFavoriteCards();
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializeFavorites);
        } else {
            initializeFavorites();
        }
    })();
</script>
