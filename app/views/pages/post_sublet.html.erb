<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Post Sublet | NU Sublets</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600&family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <style>
            :root {
                --nu-text: #000000;
                --nu-surface: #ffffff;
                --nu-border: #d9d9d9;
                --nu-muted: #5f5f5f;
                --nu-helper: #abb5be;
                --nu-accent: #9c51b6;
                --nu-chip: #d9d9d9;
                --nu-shadow: 0 0 25px rgba(217, 217, 217, 0.5);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--nu-surface);
                color: var(--nu-text);
                font-family: "Fustat", sans-serif;
            }

            a {
                color: inherit;
            }

            button,
            input,
            textarea {
                font: inherit;
            }

            .page-shell {
                min-height: 100vh;
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid var(--nu-border);
                font-family: "Rubik", sans-serif;
                padding: 0 24px;
                min-height: 60px;
                display: flex;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .topbar-inner {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-nav {
                gap: 28px;
            }

            .brand,
            .nav-link {
                color: var(--nu-text);
                font-size: 16px;
                line-height: 1.2;
                text-decoration: none;
            }

            .brand {
                font-weight: 400;
            }

            .post-page {
                padding: 46px 24px 72px;
            }

            .post-shell {
                max-width: 600px;
                margin: 0 auto;
            }

            .page-title {
                margin: 0 0 16px;
                padding-inline: 32px;
                font-family: "Rubik", sans-serif;
                font-size: clamp(2rem, 4vw, 2.25rem);
                font-weight: 700;
                line-height: 1.2;
            }

            .post-card {
                background: #fff;
                border-radius: 16px;
                box-shadow: var(--nu-shadow);
                padding: 32px 48px;
            }

            .section-block + .section-block {
                margin-top: 16px;
            }

            .section-title {
                margin: 0;
                font-family: "Rubik", sans-serif;
                font-size: 20px;
                font-weight: 400;
                line-height: 2;
            }

            .section-helper {
                margin: 0;
                font-size: 14px;
                line-height: 2;
                color: var(--nu-muted);
            }

            .field-stack {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .field-grid {
                display: grid;
                gap: 8px;
            }

            .field-grid.two-col {
                grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
            }

            .field-grid.city-row,
            .field-grid.single-col {
                grid-template-columns: minmax(0, 1fr);
            }

            .field-grid.state-row {
                grid-template-columns: minmax(0, 1.9fr) minmax(0, 0.9fr);
                gap: 18px;
            }

            .availability-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px;
            }

            .field-label {
                display: block;
                font-size: 14px;
                line-height: 2;
                color: var(--nu-text);
            }

            .field-input,
            .field-textarea,
            .date-field {
                width: 100%;
                border: 1px solid var(--nu-border);
                border-radius: 8px;
                background: #fff;
                color: var(--nu-text);
                font-size: 16px;
                line-height: 2;
                min-height: 52px;
            }

            .field-input,
            .field-textarea {
                padding: 8px 16px;
            }

            .field-input::placeholder,
            .field-textarea::placeholder,
            .date-value::placeholder {
                color: var(--nu-text);
                opacity: 1;
            }

            .field-textarea {
                min-height: 104px;
                resize: vertical;
            }

            .date-field {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 8px 16px;
            }

            .date-value {
                width: 100%;
                border: 0;
                outline: 0;
                padding: 0;
                background: transparent;
                font-size: 16px;
                line-height: 2;
            }

            .icon-button {
                width: 24px;
                height: 24px;
                padding: 0;
                border: 0;
                background: transparent;
                color: var(--nu-text);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
            }

            .icon-button svg,
            .chip-icon svg {
                display: block;
            }

            .price-field {
                display: flex;
                align-items: center;
                gap: 4px;
                padding-inline: 16px;
            }

            .prefix {
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                line-height: 2;
            }

            .rubik-input {
                font-family: "Rubik", sans-serif;
            }

            .field-input.no-border {
                border: 0;
                min-height: auto;
                padding: 0;
                background: transparent;
            }

            .field-input.no-border:focus {
                outline: 0;
            }

            .price-field:focus-within,
            .phone-field:focus-within {
                border-color: var(--nu-text);
                box-shadow: 0 0 0 1px var(--nu-text);
            }

            .search-input {
                min-height: 52px;
            }

            .amenities-picker {
                position: relative;
            }

            .amenities-picker.is-open {
                margin-bottom: 236px;
            }

            .amenity-results {
                display: none;
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                right: 0;
                z-index: 20;
                gap: 8px;
                max-height: 220px;
                overflow-y: auto;
                padding: 8px;
                border: 1px solid var(--nu-border);
                border-radius: 8px;
                background: #fff;
                box-shadow: var(--nu-shadow);
            }

            .amenities-picker.is-open .amenity-results {
                display: grid;
            }

            .amenity-option {
                width: 100%;
                border: 1px solid transparent;
                border-radius: 8px;
                background: #fff;
                color: var(--nu-text);
                text-align: left;
                padding: 8px 10px;
                font-size: 14px;
                line-height: 1.4;
                transition: background 0.2s ease, border-color 0.2s ease;
            }

            .amenity-option:hover,
            .amenity-option:focus-visible {
                background: #f7f2f9;
                border-color: var(--nu-accent);
            }

            .amenity-option[disabled] {
                cursor: default;
                color: var(--nu-muted);
                background: #f7f7f7;
                border-color: transparent;
            }

            .empty-amenities {
                margin: 0;
                color: var(--nu-muted);
                font-size: 14px;
                line-height: 1.6;
            }

            .chip-row {
                display: flex;
                flex-wrap: wrap;
                gap: 12px 24px;
            }

            .chip {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 4px 8px;
                border-radius: 8px;
                background: var(--nu-chip);
                min-height: 32px;
            }

            .chip-button {
                border: 0;
                background: transparent;
                padding: 0;
                color: var(--nu-text);
                cursor: pointer;
            }

            .chip-icon {
                width: 24px;
                height: 24px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: var(--nu-text);
                flex: 0 0 auto;
            }

            .chip-label {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-family: "Rubik", sans-serif;
                font-size: 12px;
                line-height: 2;
            }

            .upload-box {
                width: 112px;
                height: 72px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 0;
                border-radius: 0;
                background: var(--nu-chip);
                color: #fff;
                font-size: 28px;
                line-height: 1;
                cursor: pointer;
                transition: opacity 0.2s ease, transform 0.2s ease;
            }

            .upload-box:hover,
            .upload-box:focus-visible {
                opacity: 0.88;
                transform: translateY(-1px);
            }

            .photo-input {
                display: none;
            }

            .photo-upload-row {
                display: flex;
                flex-wrap: wrap;
                align-items: flex-start;
                gap: 8px;
            }

            .photo-preview-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .photo-preview {
                width: 112px;
                height: 72px;
                padding: 0;
                border: 0;
                border-radius: 0;
                overflow: hidden;
                background: var(--nu-chip);
                cursor: pointer;
                position: relative;
            }

            .photo-preview::after {
                content: "Remove";
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(0, 0, 0, 0.6);
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 12px;
                font-weight: 500;
                opacity: 0;
                transition: opacity 0.2s ease;
            }

            .photo-preview:hover::after,
            .photo-preview:focus-visible::after {
                opacity: 1;
            }

            .photo-preview img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .photo-status {
                margin: 0;
                font-size: 14px;
                line-height: 1.6;
                color: var(--nu-muted);
            }

            .phone-field {
                display: flex;
                align-items: center;
                gap: 8px;
                padding-inline: 16px;
            }

            .checkbox-row {
                display: grid;
                grid-template-columns: 16px minmax(0, 1fr);
                align-items: start;
                gap: 16px;
                margin-top: 12px;
            }

            .checkbox-row input[type="checkbox"] {
                width: 16px;
                height: 16px;
                margin-top: 4px;
                border: 1px solid var(--nu-helper);
                accent-color: var(--nu-accent);
            }

            .checkbox-copy {
                margin: 0;
                font-size: 14px;
                line-height: 1.5;
            }

            .submit-button {
                width: 100%;
                border: 0;
                border-radius: 16px;
                background: var(--nu-accent);
                color: #fff;
                font-family: "Rubik", sans-serif;
                font-size: 16px;
                font-weight: 600;
                line-height: 1.5;
                padding: 16px 10px;
                transition: transform 0.2s ease, opacity 0.2s ease;
            }

            .submit-button:hover,
            .submit-button:focus-visible {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            @media (max-width: 767.98px) {
                .topbar {
                    padding-inline: 16px;
                }

                .topbar-nav {
                    gap: 20px;
                }

                .brand,
                .nav-link {
                    font-size: 14px;
                }

                .post-page {
                    padding: 28px 16px 48px;
                }

                .page-title {
                    padding-inline: 0;
                    margin-bottom: 20px;
                    font-size: clamp(1.8rem, 9vw, 2.2rem);
                }

                .post-card {
                    padding: 24px 20px;
                }

                .field-grid.two-col,
                .field-grid.state-row,
                .availability-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 8px;
                }

                .chip-row {
                    gap: 8px;
                }

                .checkbox-row {
                    gap: 12px;
                }
            }
        </style>
    </head>
    <body>
        <div class="page-shell">
            <header class="topbar">
                <div class="topbar-inner">
                    <a class="brand" href="<%= root_path %>">NU-Sublets</a>
                    <nav class="d-flex align-items-center topbar-nav">
                        <a class="nav-link p-0" href="<%= root_path(anchor: 'recommendations') %>">Browse</a>
                        <a class="nav-link p-0" href="<%= search_results_path %>">Search</a>
                        <a class="nav-link p-0" href="<%= listing_path %>">View Listing</a>
                        <a class="nav-link p-0" href="<%= login_path %>">Log in</a>
                    </nav>
                </div>
            </header>

            <main class="post-page">
                <div class="post-shell">
                    <h1 class="page-title">List your apartment</h1>

                    <%= form_with url: submit_sublet_path, method: :post, local: true, html: { multipart: true }, class: "post-card" do %>
                        <section class="section-block field-stack">
                            <div>
                                <h2 class="section-title">Address</h2>
                                <p class="section-helper">Tell us where your room is</p>
                            </div>

                            <div class="field-grid two-col">
                                <input class="field-input" type="text" name="street-address" placeholder="Street Address" />
                                <input class="field-input" type="text" name="address-line-2" placeholder="Apt, suite, etc. (optional)" />
                            </div>

                            <div class="field-grid city-row">
                                <input class="field-input" type="text" name="city" placeholder="City" />
                            </div>

                            <div class="field-grid state-row">
                                <input class="field-input" type="text" name="state" placeholder="State" />
                                <input class="field-input" type="text" name="zip-code" placeholder="Zip Code" />
                            </div>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Availability</h2>

                            <div class="availability-grid">
                                <label class="field-stack">
                                    <span class="field-label">Start Date</span>
                                    <span class="date-field">
                                        <input class="date-value" type="text" name="start-date" placeholder="mm/dd/yyyy" />
                                        <button class="icon-button" type="button" aria-label="Open start date picker">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M7 2v3M17 2v3M3 9h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                                <rect x="4" y="5" width="16" height="15" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                                            </svg>
                                        </button>
                                    </span>
                                </label>

                                <label class="field-stack">
                                    <span class="field-label">End Date</span>
                                    <span class="date-field">
                                        <input class="date-value" type="text" name="end-date" placeholder="mm/dd/yyyy" />
                                        <button class="icon-button" type="button" aria-label="Open end date picker">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M7 2v3M17 2v3M3 9h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                                <rect x="4" y="5" width="16" height="15" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                                            </svg>
                                        </button>
                                    </span>
                                </label>
                            </div>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Rent</h2>
                            <label class="field-input price-field">
                                <span class="prefix">$</span>
                                <input class="field-input no-border" type="text" name="price" placeholder="Price" />
                            </label>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Description</h2>
                            <textarea class="field-textarea" name="description" placeholder="Describe apartment here"></textarea>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Amenities</h2>
                            <div class="amenities-picker" data-amenities-picker>
                                <input
                                    class="field-input search-input"
                                    type="search"
                                    name="amenities-search"
                                    placeholder="Search Amenities"
                                    autocomplete="off"
                                    aria-controls="amenity-results"
                                    aria-expanded="false"
                                    data-amenity-search
                                />

                                <div class="amenity-results" id="amenity-results" aria-label="Available amenities" data-amenity-results></div>
                            </div>

                            <div class="chip-row" aria-label="Selected amenities" data-selected-amenities>
                                <p class="empty-amenities" data-empty-amenities>No amenities added yet</p>
                            </div>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Preferences</h2>
                            <div class="amenities-picker" data-preferences-picker>
                                <input
                                    class="field-input search-input"
                                    type="search"
                                    name="preferences-search"
                                    placeholder="Search Preferences"
                                    autocomplete="off"
                                    aria-controls="preference-results"
                                    aria-expanded="false"
                                    data-preference-search
                                />

                                <div class="amenity-results" id="preference-results" aria-label="Available preferences" data-preference-results></div>
                            </div>

                            <div class="chip-row" aria-label="Selected preferences" data-selected-preferences>
                                <p class="empty-amenities" data-empty-preferences>No preferences added yet</p>
                            </div>
                        </section>

                        <section class="section-block field-stack">
                            <div>
                                <h2 class="section-title">Photos</h2>
                                <p class="section-helper">You must upload a minimum of 4 photos</p>
                            </div>

                            <div class="photo-upload-row">
                                <button class="upload-box" type="button" aria-label="Upload photos" data-photo-upload-trigger>+</button>
                                <input class="photo-input" type="file" name="photos[]" accept="image/*" multiple data-photo-input />
                                <div class="photo-preview-grid" aria-label="Selected photos" data-photo-preview></div>
                            </div>
                            <p class="photo-status" data-photo-status>No photos selected</p>
                        </section>

                        <section class="section-block field-stack">
                            <h2 class="section-title">Phone</h2>
                            <label class="field-input phone-field">
                                <span class="prefix">+1</span>
                                <input class="field-input no-border rubik-input" type="tel" name="phone" aria-label="Phone number" />
                            </label>
                        </section>

                        <section class="section-block field-stack">
                            <div>
                                <h2 class="section-title">School Email</h2>
                                <p class="section-helper">School email will be used to verify your student status</p>
                            </div>

                            <input class="field-input" type="email" name="school-email" placeholder="ex: janedoe@u.northwestern.edu" />
                        </section>

                        <section class="section-block">
                            <label class="checkbox-row">
                                <input type="checkbox" name="terms" />
                                <span class="checkbox-copy">By checking this box, I confirm that I have read, understood, and agree to the Terms and Conditions and Privacy Policy.</span>
                            </label>
                        </section>

                        <section class="section-block">
                            <button class="submit-button" type="button" data-login-trigger>Post Sublet</button>
                        </section>
                    <% end %>
                </div>
            </main>
        </div>
        <script>
            (() => {
                const photoTrigger = document.querySelector("[data-photo-upload-trigger]");
                const photoInput = document.querySelector("[data-photo-input]");
                const photoPreview = document.querySelector("[data-photo-preview]");
                const photoStatus = document.querySelector("[data-photo-status]");
                let photoPreviewUrls = [];
                let selectedPhotos = [];

                const clearPhotoPreviewUrls = () => {
                    photoPreviewUrls.forEach((url) => URL.revokeObjectURL(url));
                    photoPreviewUrls = [];
                };

                const syncPhotoInput = () => {
                    if (!photoInput) return;

                    const transfer = new DataTransfer();
                    selectedPhotos.forEach((file) => transfer.items.add(file));
                    photoInput.files = transfer.files;
                };

                const renderPhotoPreview = () => {
                    if (!photoInput || !photoPreview || !photoStatus) return;

                    clearPhotoPreviewUrls();
                    photoPreview.innerHTML = "";

                    const files = selectedPhotos;
                    photoStatus.textContent = files.length === 0
                        ? "No photos selected"
                        : `${files.length} photo${files.length === 1 ? "" : "s"} selected`;

                    files.forEach((file, index) => {
                        const url = URL.createObjectURL(file);
                        photoPreviewUrls.push(url);

                        const preview = document.createElement("button");
                        preview.className = "photo-preview";
                        preview.type = "button";
                        preview.setAttribute("aria-label", `Remove ${file.name}`);

                        const image = document.createElement("img");
                        image.src = url;
                        image.alt = file.name;

                        preview.addEventListener("click", () => {
                            selectedPhotos.splice(index, 1);
                            syncPhotoInput();
                            renderPhotoPreview();
                        });

                        preview.appendChild(image);
                        photoPreview.appendChild(preview);
                    });
                };

                photoTrigger?.addEventListener("click", () => {
                    photoInput?.click();
                });

                photoInput?.addEventListener("change", () => {
                    const newPhotos = Array.from(photoInput.files || []);
                    selectedPhotos = selectedPhotos.concat(newPhotos);
                    syncPhotoInput();
                    renderPhotoPreview();
                });

                const amenities = [
                    "Furnished",
                    "Laundry",
                    "AC / Heat",
                    "WiFi",
                    "TV",
                    "Hardwood floors",
                    "Natural light",
                    "Storage",
                    "Private bath / Shared bath",
                    "Updated kitchen",
                    "Dishwasher",
                    "Microwave",
                    "Balcony / Patio",
                    "Elevator",
                    "Secure entry",
                    "Doorman",
                    "Package room",
                    "Bike storage",
                    "Gym",
                    "Rooftop",
                    "Study rooms",
                    "Parking",
                    "Pet-friendly",
                    "Near Northwestern University",
                    "Downtown Evanston",
                    "Transit access",
                    "Lakefront (Lake Michigan)",
                    "Grocery nearby",
                    "Restaurants",
                    "Safe area",
                    "Utilities included",
                    "Flexible lease",
                    "Lease option",
                    "Clean space",
                    "Stocked kitchen",
                    "Work setup",
                    "Quiet / Social"
                ];

                const preferences = [
                    "Student preferred",
                    "Graduate student",
                    "Young professional",
                    "Male",
                    "Female",
                    "Non-smoker",
                    "No pets",
                    "Pet-friendly",
                    "Clean",
                    "Quiet",
                    "Respectful",
                    "Responsible",
                    "Organized",
                    "Easygoing",
                    "Social",
                    "Independent",
                    "No overnight guests",
                    "No parties",
                    "Light cooking",
                    "Good hygiene",
                    "Communicative",
                    "Reliable",
                    "LGBTQ+ friendly"
                ];

                const normalize = (value) => value.toLowerCase().trim();

                const setupPicker = ({
                    items,
                    pickerSelector,
                    searchSelector,
                    resultsSelector,
                    selectedSelector,
                    emptySelector,
                    fieldName,
                    emptyResultsText
                }) => {
                    const picker = document.querySelector(pickerSelector);
                    if (!picker) return;

                    const searchInput = picker.querySelector(searchSelector);
                    const results = picker.querySelector(resultsSelector);
                    const selectedRow = document.querySelector(selectedSelector);
                    const emptyState = document.querySelector(emptySelector);
                    const selectedItems = new Set();

                    const filteredItems = () => {
                        const query = normalize(searchInput.value);
                        return items.filter((item) => normalize(item).includes(query));
                    };

                    const refreshEmptyState = () => {
                        emptyState.hidden = selectedItems.size > 0;
                    };

                    const openDropdown = () => {
                        picker.classList.add("is-open");
                        searchInput.setAttribute("aria-expanded", "true");
                    };

                    const closeDropdown = () => {
                        picker.classList.remove("is-open");
                        searchInput.setAttribute("aria-expanded", "false");
                    };

                    const renderResults = () => {
                        results.innerHTML = "";
                        const matches = filteredItems();

                        if (matches.length === 0) {
                            const empty = document.createElement("p");
                            empty.className = "empty-amenities";
                            empty.textContent = emptyResultsText;
                            results.appendChild(empty);
                            return;
                        }

                        matches.forEach((item) => {
                            const option = document.createElement("button");
                            option.className = "amenity-option";
                            option.type = "button";
                            option.textContent = item;
                            option.disabled = selectedItems.has(item);
                            option.setAttribute("aria-pressed", selectedItems.has(item).toString());
                            option.addEventListener("click", () => addItem(item));
                            results.appendChild(option);
                        });
                    };

                    const addItem = (item) => {
                        if (selectedItems.has(item)) return;

                        selectedItems.add(item);

                        const chip = document.createElement("span");
                        chip.className = "chip";

                        const removeButton = document.createElement("button");
                        removeButton.className = "chip-icon chip-button";
                        removeButton.type = "button";
                        removeButton.setAttribute("aria-label", `Remove ${item}`);
                        removeButton.innerHTML = `
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M7 7l10 10M17 7L7 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        `;

                        const label = document.createElement("span");
                        label.className = "chip-label";
                        label.textContent = item;

                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = fieldName;
                        input.value = item;

                        removeButton.addEventListener("click", () => {
                            selectedItems.delete(item);
                            chip.remove();
                            refreshEmptyState();
                            renderResults();
                        });

                        chip.append(removeButton, label, input);
                        selectedRow.appendChild(chip);
                        searchInput.value = "";
                        refreshEmptyState();
                        renderResults();
                        searchInput.focus();
                    };

                    searchInput.addEventListener("focus", openDropdown);
                    searchInput.addEventListener("click", openDropdown);
                    searchInput.addEventListener("input", () => {
                        renderResults();
                        openDropdown();
                    });
                    searchInput.addEventListener("keydown", (event) => {
                        if (event.key === "Escape") {
                            closeDropdown();
                            searchInput.blur();
                            return;
                        }

                        if (event.key !== "Enter") return;

                        event.preventDefault();
                        const firstAvailable = filteredItems().find((item) => !selectedItems.has(item));
                        if (firstAvailable) addItem(firstAvailable);
                    });

                    document.addEventListener("pointerdown", (event) => {
                        if (!picker.contains(event.target)) closeDropdown();
                    });

                    renderResults();
                    refreshEmptyState();
                };

                setupPicker({
                    items: amenities,
                    pickerSelector: "[data-amenities-picker]",
                    searchSelector: "[data-amenity-search]",
                    resultsSelector: "[data-amenity-results]",
                    selectedSelector: "[data-selected-amenities]",
                    emptySelector: "[data-empty-amenities]",
                    fieldName: "amenities[]",
                    emptyResultsText: "No matching amenities"
                });

                setupPicker({
                    items: preferences,
                    pickerSelector: "[data-preferences-picker]",
                    searchSelector: "[data-preference-search]",
                    resultsSelector: "[data-preference-results]",
                    selectedSelector: "[data-selected-preferences]",
                    emptySelector: "[data-empty-preferences]",
                    fieldName: "preferences[]",
                    emptyResultsText: "No matching preferences"
                });
            })();
        </script>
        <%= render "login_modal" %>
    </body>
</html>
